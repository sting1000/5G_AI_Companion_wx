/* 全局样式 - 适老化设计 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  background-color: #FFF7EE;
  color: #2D2A26;
  font-size: 32rpx;
  line-height: 1.6;
}

/* 设计 token（阶段一保守模式：仅收口，不重塑视觉） */
:root {
  --color-bg-page: #FFF7EE;
  --color-bg-card: #FFFFFF;
  --color-bg-subtle: #F7F1EA;
  --color-text-primary: #2D2A26;
  --color-text-secondary: #66615C;
  --color-text-muted: #8A8580;
  --color-border: #E8E4DF;
  --color-brand: #FF7A59;
  --color-brand-pressed: #E9503D;
  --color-care-deep: #7A4B36;
  --color-care-green: #7C8F62;
  --color-accent-blue: #FF8A65;
  --color-success-soft: #EAF8ED;
  --color-success-text: #2E7D32;
  --color-warning-soft: #FFF8DB;
  --color-warning-text: #9A6700;
  --color-danger-soft: #FFECEB;
  --color-danger-text: #B42318;
  --radius-input: 16rpx;
  --radius-card: 24rpx;
  --radius-pill: 48rpx;
  --space-page-x: 40rpx;
  --space-card: 32rpx;
  --space-gap-sm: 16rpx;
  --space-gap-md: 24rpx;
  --space-gap-lg: 32rpx;
  --font-title: 36rpx;
  --font-body: 30rpx;
  --font-caption: 24rpx;
  --shadow-card: 0 14rpx 46rpx rgba(75, 68, 58, 0.08);
}

/* 通用基础类 */
.ui-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: var(--space-card);
  box-shadow: var(--shadow-card);
}

.ui-section-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 700;
  color: var(--color-text-primary);
}

.ui-state-hint {
  display: block;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  line-height: 1.5;
}

.ui-empty {
  text-align: center;
  color: var(--color-text-muted);
  font-size: 28rpx;
  padding: 48rpx 24rpx;
}

.ui-btn-primary {
  background: var(--color-brand);
  color: #FFFFFF;
  border: none;
  border-radius: var(--radius-pill);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  min-height: 96rpx;
  line-height: 96rpx;
  box-sizing: border-box;
}

.ui-btn-primary:active {
  background: var(--color-brand-pressed);
}

.ui-btn-primary[disabled] {
  opacity: 0.55;
}

.ui-btn-secondary {
  background: #FFFFFF;
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-pill);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  min-height: 96rpx;
  line-height: 96rpx;
  box-sizing: border-box;
}

.ui-btn-secondary:active {
  background: var(--color-bg-subtle);
}

.ui-btn-secondary[disabled] {
  opacity: 0.55;
}

/* 兼容旧类名，避免全量替换导致视觉突变 */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: var(--space-card);
  box-shadow: var(--shadow-card);
}

.btn-primary {
  background: var(--color-brand);
  color: #FFFFFF;
  border: none;
  border-radius: var(--radius-pill);
  min-height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.btn-primary:active {
  background: var(--color-brand-pressed);
}

.btn-primary[disabled] {
  opacity: 0.55;
}

.btn-secondary {
  background: #FFFFFF;
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-pill);
  min-height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.btn-secondary:active {
  background: var(--color-bg-subtle);
}
