/* 叮嘱全局视觉基础 */
page {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  background-color: #F3F4F2;
  color: #1E292D;
  font-size: 30rpx;
  line-height: 1.47;
}

/* DESIGN_SYSTEM.md 冻结 Token */
:root {
  --color-bg-page: #F3F4F2;
  --color-bg-card: #FFFFFF;
  --color-bg-subtle: #DCE9EA;
  --color-text-primary: #1E292D;
  --color-text-secondary: #657277;
  --color-text-muted: #657277;
  --color-border: #DDE2E0;
  --color-brand: #315E6B;
  --color-brand-pressed: #274C57;
  --color-care-deep: #274C57;
  --color-care-green: #3C7D65;
  --color-accent-blue: #315E6B;
  --color-success-soft: #E6F0EB;
  --color-success-text: #3C7D65;
  --color-warning-soft: #F5EBD8;
  --color-warning-text: #9A6A18;
  --color-danger-soft: #F8E5E5;
  --color-danger-text: #C83F3F;
  --color-call-overlay: rgba(18, 24, 25, 0.78);
  --radius-input: 20rpx;
  --radius-card: 36rpx;
  --radius-hero: 48rpx;
  --radius-pill: 999rpx;
  --space-page-x: 32rpx;
  --space-card: 32rpx;
  --space-gap-sm: 16rpx;
  --space-gap-md: 24rpx;
  --space-gap-lg: 48rpx;
  --font-display: 52rpx;
  --font-title: 44rpx;
  --font-section: 36rpx;
  --font-body-lg: 34rpx;
  --font-body: 30rpx;
  --font-label: 28rpx;
  --font-caption: 26rpx;
  --shadow-card: 0 12rpx 36rpx rgba(24, 40, 43, 0.06);
}

/* 通用基础类 */
.ui-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: var(--space-card);
  box-shadow: var(--shadow-card);
}

.ui-section-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 700;
  color: var(--color-text-primary);
}

.ui-state-hint {
  display: block;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  line-height: 1.5;
}

.ui-empty {
  text-align: center;
  color: var(--color-text-muted);
  font-size: 28rpx;
  padding: 48rpx 24rpx;
}

.ui-btn-primary {
  background: var(--color-brand);
  color: #FFFFFF;
  border: none;
  border-radius: var(--radius-pill);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  min-height: 112rpx;
  line-height: 112rpx;
  box-sizing: border-box;
}

.ui-btn-primary:active {
  background: var(--color-brand-pressed);
  transform: scale(0.98);
}

.ui-btn-primary[disabled] {
  opacity: 0.55;
}

.ui-btn-secondary {
  background: #FFFFFF;
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-pill);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  min-height: 96rpx;
  line-height: 96rpx;
  box-sizing: border-box;
}

.ui-btn-secondary:active {
  background: var(--color-bg-subtle);
}

.ui-btn-secondary[disabled] {
  opacity: 0.55;
}

/* 兼容旧类名，避免全量替换导致视觉突变 */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: var(--space-card);
  box-shadow: var(--shadow-card);
}

.btn-primary {
  background: var(--color-brand);
  color: #FFFFFF;
  border: none;
  border-radius: var(--radius-pill);
  min-height: 112rpx;
  line-height: 112rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.btn-primary:active {
  background: var(--color-brand-pressed);
  transform: scale(0.98);
}

.btn-primary[disabled] {
  opacity: 0.55;
}

.btn-secondary {
  background: #FFFFFF;
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-pill);
  min-height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.btn-secondary:active {
  background: var(--color-bg-subtle);
}

.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
