.dashboard-page {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(circle at 8% 14%, rgba(220, 233, 234, 0.7), transparent 30%),
    #F3F4F2;
  color: #1E292D;
}

.custom-nav {
  padding: 0 32rpx;
  box-sizing: border-box;
}

.custom-nav__inner {
  display: flex;
  align-items: center;
}

.brand-name {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.offline-banner {
  min-height: 64rpx;
  margin: 0 32rpx 8rpx;
  padding: 8rpx 12rpx 8rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  color: #71501A;
  background: #F5EBD8;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 36rpx;
}

.banner-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.banner-action {
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 4rpx 12rpx;
  margin: 0 0 0 auto;
  color: #71501A;
  font-size: 26rpx;
  line-height: 36rpx;
  background: transparent;
}

.dashboard-scroll {
  flex: 1;
  min-height: 0;
}

.dashboard-content {
  padding: 24rpx 32rpx calc(232rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.greeting-block {
  display: flex;
  flex-direction: column;
  margin-bottom: 48rpx;
}

.greeting {
  font-size: 52rpx;
  line-height: 68rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.date {
  margin-top: 8rpx;
  color: #657277;
  font-size: 28rpx;
  line-height: 40rpx;
}

.notification-banner {
  margin-bottom: 40rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2rpx solid #DDE2E0;
  border-radius: 24rpx;
}

.notification-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  color: #657277;
  font-size: 26rpx;
  line-height: 36rpx;
}

.notification-icon {
  width: 36rpx;
  height: 36rpx;
  min-width: 36rpx;
  margin-right: 16rpx;
}

.notification-action {
  min-width: 112rpx;
  min-height: 88rpx;
  margin: 0 0 0 16rpx;
  padding: 8rpx 16rpx;
  color: #315E6B;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 600;
  background: #DCE9EA;
  border-radius: 999rpx;
}

.section {
  margin-bottom: 48rpx;
}

.section-title {
  display: block;
  margin: 0 8rpx 20rpx;
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 600;
}

.next-reminder {
  width: 100%;
  min-height: 280rpx;
  margin: 0;
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  color: #1E292D;
  background: linear-gradient(145deg, #EDF5F4 0%, #DCE9EA 100%);
  border: 2rpx solid rgba(49, 94, 107, 0.12);
  border-radius: 48rpx;
  box-shadow: 0 12rpx 36rpx rgba(24, 40, 43, 0.06);
}

.next-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.next-time {
  color: #315E6B;
  font-size: 76rpx;
  line-height: 88rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: -2rpx;
}

.next-title {
  margin-top: 8rpx;
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 600;
}

.next-repeat {
  margin-top: 8rpx;
  color: #657277;
  font-size: 26rpx;
  line-height: 36rpx;
}

.next-status {
  min-width: 128rpx;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #315E6B;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 600;
}

.next-status__icon {
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.58);
  border-radius: 50%;
}

.next-status__icon image {
  width: 56rpx;
  height: 56rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.text-link {
  min-width: 112rpx;
  min-height: 88rpx;
  margin: -20rpx 0 0;
  padding: 16rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #315E6B;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 600;
  background: transparent;
}

.other-list {
  overflow: hidden;
  background: #FFFFFF;
  border: 2rpx solid #DDE2E0;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 36rpx rgba(24, 40, 43, 0.04);
}

.other-reminder {
  width: 100%;
  min-height: 112rpx;
  margin: 0;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  text-align: left;
  color: #1E292D;
  background: #FFFFFF;
  border-radius: 0;
}

.other-reminder + .other-reminder {
  border-top: 2rpx solid #DDE2E0;
}

.other-time {
  min-width: 132rpx;
  color: #315E6B;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.other-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.other-title {
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: 500;
}

.other-repeat {
  margin-top: 2rpx;
  color: #657277;
  font-size: 26rpx;
  line-height: 36rpx;
}

.chevron {
  width: 36rpx;
  height: 36rpx;
  margin-left: 12rpx;
}

.quick-links {
  min-height: 96rpx;
  margin: 8rpx 8rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-link {
  min-width: 200rpx;
  min-height: 88rpx;
  padding: 12rpx 24rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #657277;
  font-size: 28rpx;
  line-height: 40rpx;
  background: transparent;
}

.quick-link image {
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
}

.quick-divider {
  width: 2rpx;
  height: 40rpx;
  background: #DDE2E0;
}

.call-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(243, 244, 242, 0), #F3F4F2 24%, #F3F4F2 100%);
}

.call-helper {
  display: block;
  margin-bottom: 16rpx;
  color: #657277;
  text-align: center;
  font-size: 26rpx;
  line-height: 36rpx;
}

.call-button {
  width: 100%;
  min-height: 112rpx;
  margin: 0;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  background: #315E6B;
  border-radius: 999rpx;
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 38rpx rgba(49, 94, 107, 0.2);
}

.call-button image {
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
}

.call-button:active {
  background: #274C57;
  transform: scale(0.98);
}

.reminder-skeleton,
.load-error,
.empty-state {
  min-height: 260rpx;
  padding: 40rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border: 2rpx solid #DDE2E0;
  border-radius: 48rpx;
}

.reminder-skeleton {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.skeleton-line {
  height: 32rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(90deg, #E7EBE9, #F4F6F5, #E7EBE9);
  background-size: 200% 100%;
  border-radius: 16rpx;
  animation: shimmer 1.4s ease infinite;
}

.skeleton-time {
  width: 44%;
  height: 68rpx;
}

.skeleton-title {
  width: 60%;
}

.skeleton-caption {
  width: 30%;
  margin-bottom: 0;
}

.load-error,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #DCE9EA;
  border-radius: 50%;
}

.state-icon {
  width: 52rpx;
  height: 52rpx;
}

.state-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.state-description {
  margin-top: 8rpx;
  color: #657277;
  font-size: 26rpx;
  line-height: 38rpx;
}

.retry-button {
  min-width: 200rpx;
  min-height: 88rpx;
  margin: 24rpx 0 0;
  padding: 16rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #315E6B;
  background: #DCE9EA;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 600;
}

.retry-button image {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

button::after {
  border: 0;
}

@keyframes shimmer {
  to {
    background-position: -200% 0;
  }
}
