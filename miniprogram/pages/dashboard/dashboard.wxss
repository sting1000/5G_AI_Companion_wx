.container {
  min-height: 100vh;
  background-color: #F8F9FA;
  display: flex;
  flex-direction: column;
}

/* 顶部自定义导航栏 */
.custom-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 100rpx 40rpx 20rpx;
  background-color: #FFF;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.icon-avatar {
  width: 64rpx;
  height: 64rpx;
  background-color: #FF6B4A;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: white;
  font-size: 32rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.bell-icon {
  position: relative;
  font-size: 40rpx;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background-color: #FF3B30;
  color: white;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 20rpx;
  min-width: 24rpx;
  text-align: center;
}

.user-avatar-small {
  width: 64rpx;
  height: 64rpx;
  background-color: #FFE5D9;
  color: #FF6B4A;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-weight: bold;
}

/* 预警条 */
.warning-bar {
  background-color: #FFF0F0;
  color: #FF3B30;
  padding: 20rpx 40rpx;
  font-size: 26rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-weight: 500;
}

.scroll-content {
  flex: 1;
  padding: 40rpx 0 200rpx;
}

/* 卡片通用类 */
.card {
  background: white;
  border-radius: 24rpx;
  margin: 0 40rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
  padding: 32rpx;
}

/* 父母信息卡片 */
.parent-card {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.parent-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #FFE5D9;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 60rpx;
}

.parent-info {
  display: flex;
  flex-direction: column;
}

.parent-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.last-call {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.mood-badge {
  display: inline-flex;
  align-items: center;
  background-color: #E8F5E9;
  color: #4CAF50;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  width: fit-content;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  position: relative;
}

.sparkle-icon {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 48rpx;
  color: #FFD54F;
  opacity: 0.5;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: #F0F0F0;
}

/* 发现兴趣信号卡片 */
.signal-card {
  padding: 32rpx;
}

.signal-header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.signal-icon {
  font-size: 40rpx;
  background: #E8F8F5;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.signal-title-box {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.signal-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.signal-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.signal-action {
  background-color: #F2FBF7;
  color: #2E7D32;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
}

.interest-tag {
  background: #FFF5F2;
  color: #FF6B4A;
}

.health-tag {
  background: #EAF8ED;
  color: #2E7D32;
}

/* 健康信号卡片 */
.health-signal-card .signal-icon {
  background: #FFF1E8;
}

/* 底部操作 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 40rpx 32rpx;
  background: linear-gradient(to top, rgba(248, 249, 250, 1) 50%, rgba(248, 249, 250, 0));
}

.call-btn-large {
  background-color: #FF6B4A;
  color: white;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 74, 0.3);
}

.call-btn-secondary {
  margin-top: 16rpx;
  height: 88rpx;
  border-radius: 44rpx;
  border: 2rpx solid #ff6b4a;
  background: #ffffff;
  color: #ff6b4a;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-icon {
  margin-right: 12rpx;
  font-size: 36rpx;
}

/* 通话行 */
.call-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 28rpx 32rpx;
}

.call-mood {
  font-size: 44rpx;
  flex-shrink: 0;
}

.call-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.call-date {
  font-size: 28rpx;
  color: #2D2A26;
  font-weight: 500;
}

.call-duration {
  font-size: 24rpx;
  color: #8A8580;
  margin-top: 4rpx;
}

.call-arrow {
  font-size: 36rpx;
  color: #C0BCB8;
  flex-shrink: 0;
}
