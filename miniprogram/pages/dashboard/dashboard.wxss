.dashboard-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF7EE 0%, #F4F7F4 58%, #F8F2EA 100%);
  color: var(--color-text-primary);
  display: flex;
  flex-direction: column;
}

.dashboard-nav {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 96rpx 36rpx 22rpx;
  box-sizing: border-box;
}

.nav-kicker {
  display: block;
  font-size: 22rpx;
  line-height: 1.2;
  letter-spacing: 3rpx;
  color: #8A6A54;
}

.nav-title {
  display: block;
  margin-top: 8rpx;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #2D2A26;
}

.warning-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #D98258;
  box-shadow: 0 0 0 8rpx rgba(217, 130, 88, 0.14);
}

.warning-bar {
  margin: 0 36rpx 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #8A3A2D;
  background: #FFE8E1;
  font-size: 26rpx;
  font-weight: 600;
}

.warning-dot {
  background: #E85F4F;
  box-shadow: 0 0 0 8rpx rgba(232, 95, 79, 0.12);
}

.scroll-content {
  flex: 1;
  padding: 8rpx 0 224rpx;
  box-sizing: border-box;
}

.hero-panel {
  position: relative;
  min-height: 330rpx;
  margin: 0 30rpx 24rpx;
  border-radius: 34rpx;
  overflow: hidden;
  color: #FFFFFF;
  background: linear-gradient(135deg, #71442F 0%, #9A583B 58%, #E7835B 145%);
  box-shadow: 0 24rpx 72rpx rgba(128, 70, 40, 0.20);
}

.hero-panel::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    linear-gradient(90deg, rgba(67, 39, 27, 0.94) 0%, rgba(93, 50, 32, 0.88) 48%, rgba(129, 73, 48, 0.58) 100%),
    linear-gradient(0deg, rgba(116, 65, 43, 0.18), rgba(255, 139, 96, 0.18));
  z-index: 1;
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 74%;
  padding: 34rpx 0 34rpx 34rpx;
  box-sizing: border-box;
}

.hero-label-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.hero-label {
  display: block;
  font-size: 24rpx;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.62);
}

.hero-status {
  height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  font-size: 23rpx;
  line-height: 1;
}

.hero-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #9BE27D;
  box-shadow: 0 0 0 8rpx rgba(155, 226, 125, 0.16);
  flex-shrink: 0;
}

.elder-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
}

.elder-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #2D2A26;
  background: rgba(255, 255, 255, 0.88);
  font-size: 38rpx;
  font-weight: 800;
}

.elder-info {
  flex: 1;
  min-width: 0;
}

.elder-name {
  display: block;
  font-size: 42rpx;
  line-height: 1.16;
  font-weight: 800;
  color: #FFFFFF;
}

.last-call {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.70);
}

.mood-badge {
  display: inline-flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #FFFFFF;
}

.mood-happy { background: rgba(255, 152, 89, 0.88); }
.mood-calm { background: rgba(255, 122, 89, 0.92); }
.mood-low { background: rgba(94, 111, 130, 0.88); }
.mood-anxious { background: rgba(197, 78, 64, 0.88); }
.mood-pending { background: rgba(153, 125, 50, 0.88); }

.hero-companion {
  position: absolute;
  top: 0;
  right: 0;
  width: 38%;
  height: 100%;
  z-index: 0;
  opacity: 0.34;
  filter: saturate(0.78);
}

.stats-panel {
  display: flex;
  gap: 18rpx;
  margin: 0 30rpx 24rpx;
}

.stat-tile,
.insight-card {
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(45, 42, 38, 0.06);
  box-shadow: 0 14rpx 46rpx rgba(75, 68, 58, 0.08);
}

.stat-tile {
  flex: 1;
  min-width: 0;
  min-height: 142rpx;
  border-radius: 28rpx;
  padding: 26rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.stat-value {
  display: block;
  max-width: 100%;
  font-size: 40rpx;
  line-height: 1.18;
  font-weight: 800;
  color: #2D2A26;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stat-label {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8A8580;
}

.insight-card {
  margin: 0 30rpx 24rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  box-sizing: border-box;
}

.start-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.signal-header {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.card-mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  position: relative;
}

.card-mark::after {
  content: '';
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
}

.card-mark-warm {
  background: linear-gradient(135deg, #FFB66D, #FF765B);
}

.card-mark-interest {
  background: linear-gradient(135deg, #FFB36A, #E9674E);
}

.card-mark-health {
  background: linear-gradient(135deg, #A9BE7D, #6F8B57);
}

.signal-title-box {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.signal-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #2D2A26;
}

.signal-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #66615C;
  line-height: 1.5;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
}

.interest-tag {
  background: #FFF0E8;
  color: #C75038;
}

.health-tag {
  background: #EAF8ED;
  color: #5F7542;
}

.signal-action {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #F0FAF4;
  color: #65764D;
  font-size: 25rpx;
  line-height: 1.55;
}

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 36rpx calc(30rpx + env(safe-area-inset-bottom));
  background: linear-gradient(0deg, rgba(248, 242, 234, 1) 0%, rgba(248, 242, 234, 0.92) 68%, rgba(248, 242, 234, 0) 100%);
  box-sizing: border-box;
}

.call-btn-large,
.call-btn-secondary {
  width: 100%;
  margin: 0;
  border: none;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.call-btn-large::after,
.call-btn-secondary::after {
  border: none;
}

.call-btn-large {
  height: 98rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF7A59 0%, #E9503D 100%);
  font-size: 32rpx;
  font-weight: 800;
  box-shadow: 0 16rpx 42rpx rgba(233, 80, 61, 0.28);
}

.call-btn-secondary {
  height: 86rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  color: #8A4F35;
  background: rgba(255, 255, 255, 0.82);
  font-size: 29rpx;
  font-weight: 700;
}
