<view class="reminders-page">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="custom-nav__inner" style="height: {{navigationBarHeight}}px;">
      <button class="back-button" bindtap="goBack" aria-label="返回">
        <image src="/assets/icons/elder-back.svg" mode="aspectFit"></image>
      </button>
      <text class="nav-title">全部提醒</text>
    </view>
  </view>

  <view class="offline-banner" wx:if="{{isOffline && hasCachedContent}}">
    <image src="/assets/icons/elder-warning.svg" mode="aspectFit"></image>
    <text>当前离线，显示已保存的提醒</text>
    <button bindtap="retryLoad">重试</button>
  </view>

  <view class="loading-state" wx:if="{{isLoading}}">
    <view class="loading-line loading-line--title"></view>
    <view class="loading-line"></view>
    <view class="loading-line"></view>
  </view>

  <view class="error-state" wx:elif="{{hasError}}">
    <image src="/assets/icons/elder-warning.svg" mode="aspectFit"></image>
    <text class="state-title">{{errorText}}</text>
    <button class="retry-button" bindtap="retryLoad">
      <image src="/assets/icons/retry.svg" mode="aspectFit"></image>
      <text>重新加载</text>
    </button>
  </view>

  <scroll-view class="reminder-scroll" wx:else scroll-y enhanced show-scrollbar="{{false}}">
    <view class="reminder-content">
      <view class="empty-state" wx:if="{{reminderCount === 0}}">
        <view class="empty-icon">
          <image src="/assets/icons/clock.svg" mode="aspectFit"></image>
        </view>
        <text class="state-title">还没有提醒</text>
        <text class="state-description">回到今天，给小林打电话就能记下提醒。</text>
      </view>

      <view class="reminder-group" wx:if="{{todayReminders.length > 0}}">
        <text class="group-title">今天</text>
        <view class="group-list">
          <button
            class="reminder-row"
            wx:for="{{todayReminders}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onTapReminder"
          >
            <view class="time-column">
              <text class="row-time">{{item.displayTime}}</text>
              <text class="row-date">今天</text>
            </view>
            <view class="row-copy">
              <text class="row-title">{{item.title}}</text>
              <text class="row-meta">{{item.repeatText}} · {{item.statusText}}</text>
            </view>
            <image class="chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit"></image>
          </button>
        </view>
      </view>

      <view class="reminder-group" wx:if="{{laterReminders.length > 0}}">
        <text class="group-title">稍后</text>
        <view class="group-list">
          <button
            class="reminder-row"
            wx:for="{{laterReminders}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onTapReminder"
          >
            <view class="time-column">
              <text class="row-time">{{item.displayTime}}</text>
              <text class="row-date">{{item.status === 'candidate' ? '待确认' : item.effectiveDate}}</text>
            </view>
            <view class="row-copy">
              <text class="row-title">{{item.title}}</text>
              <text class="row-meta">{{item.repeatText}} · {{item.statusText}}</text>
            </view>
            <image class="chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit"></image>
          </button>
        </view>
      </view>

      <view class="reminder-group reminder-group--done" wx:if="{{doneReminders.length > 0}}">
        <text class="group-title">已完成</text>
        <view class="group-list">
          <button
            class="reminder-row"
            wx:for="{{doneReminders}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onTapReminder"
          >
            <view class="done-icon">
              <image src="/assets/icons/check.svg" mode="aspectFit"></image>
            </view>
            <view class="row-copy">
              <text class="row-title">{{item.title}}</text>
              <text class="row-meta">{{item.displayTime}} · {{item.repeatText}} · 已完成</text>
            </view>
            <image class="chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit"></image>
          </button>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
