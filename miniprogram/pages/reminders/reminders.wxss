.container {
  min-height: 100vh;
  background: #f8f9fa;
  padding: 24rpx;
  padding-bottom: 220rpx;
  box-sizing: border-box;
}

.header-title {
  font-size: 46rpx;
  font-weight: 600;
  color: #1f1f1f;
  margin: 12rpx 4rpx 20rpx;
}

.swipe-row {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  background: #fff;
}

.delete-action {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  background: #ef5350;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.incoming-action {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  background: #35b36c;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.card-content {
  background: #fff;
  padding: 24rpx;
  transition: transform 0.15s ease;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.title-wrap {
  display: flex;
  align-items: center;
  min-width: 0;
}

.card-title {
  font-size: 30rpx;
  color: #222;
  font-weight: 500;
  line-height: 1.35;
  word-break: break-all;
}

.status-dot {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.status-icon {
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.status-pending {
  border: 2rpx solid #c4c8cf;
  background: #fff;
}

.status-candidate {
  border: 2rpx solid #6f7d95;
  background: #eef3fb;
  color: #4f6078;
}

.status-done {
  border: 2rpx solid #2fa765;
  background: #2fa765;
  color: #fff;
}

.status-triggered {
  border: 2rpx solid #ff9f40;
  background: #fff3e5;
  color: #e77a0c;
}

.status {
  font-size: 22rpx;
  color: #ff8c6a;
  margin-left: 12rpx;
  padding-top: 4rpx;
}

.card-subtitle {
  margin-top: 10rpx;
  color: #666;
  font-size: 24rpx;
  padding-left: 52rpx;
}

.empty {
  margin-top: 120rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.editor-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.36);
  display: flex;
  align-items: flex-end;
}

.editor {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.editor-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 18rpx;
}

.input,
.picker {
  height: 72rpx;
  line-height: 72rpx;
  background: #f6f7f9;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333;
  padding: 0 18rpx;
  margin-bottom: 14rpx;
}

.section-label {
  font-size: 24rpx;
  color: #8b8b8b;
  margin: 12rpx 0 10rpx;
}

.schedule-chips {
  display: flex;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #444;
  font-size: 24rpx;
}

.chip-active {
  background: #ffe6df;
  color: #de5432;
}

.row {
  display: flex;
  gap: 14rpx;
}

.field {
  flex: 1;
}

.editor-actions {
  display: flex;
  gap: 14rpx;
}

.editor-btn {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.editor-btn.cancel {
  background: #f1f2f4;
  color: #333;
}

.editor-btn.save {
  background: #ff6b4a;
  color: #fff;
}

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx 30rpx;
  background: linear-gradient(to top, rgba(248, 249, 250, 1) 55%, rgba(248, 249, 250, 0));
}

.call-btn-large {
  margin-top: 0;
  background-color: #ff6b4a;
  color: #fff;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
}
