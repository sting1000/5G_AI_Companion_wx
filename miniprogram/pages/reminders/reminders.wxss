.reminders-page {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  color: #1E292D;
  background: #F3F4F2;
}

.custom-nav {
  padding: 0 32rpx;
  box-sizing: border-box;
  background: rgba(243, 244, 242, 0.96);
}

.custom-nav__inner {
  position: relative;
  display: flex;
  align-items: center;
}

.back-button {
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  background: transparent;
}

.back-button image {
  width: 48rpx;
  height: 48rpx;
}

.nav-title {
  position: absolute;
  left: 112rpx;
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 600;
}

.offline-banner {
  min-height: 88rpx;
  margin: 0 32rpx 8rpx;
  padding: 8rpx 12rpx 8rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  color: #71501A;
  background: #F5EBD8;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 36rpx;
}

.offline-banner > image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.offline-banner > button {
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0 0 0 auto;
  padding: 8rpx 12rpx;
  color: #71501A;
  font-size: 26rpx;
  line-height: 36rpx;
  background: transparent;
}

.reminder-scroll {
  flex: 1;
  min-height: 0;
}

.reminder-content {
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.reminder-group {
  margin-bottom: 48rpx;
}

.group-title {
  display: block;
  margin: 0 8rpx 16rpx;
  color: #657277;
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.group-list {
  overflow: hidden;
  background: #FFFFFF;
  border: 2rpx solid #DDE2E0;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 36rpx rgba(24, 40, 43, 0.04);
}

.reminder-row {
  width: 100%;
  min-height: 124rpx;
  margin: 0;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  text-align: left;
  color: #1E292D;
  background: #FFFFFF;
  border-radius: 0;
}

.reminder-row + .reminder-row {
  border-top: 2rpx solid #DDE2E0;
}

.time-column {
  width: 152rpx;
  min-width: 152rpx;
  display: flex;
  flex-direction: column;
}

.row-time {
  color: #315E6B;
  font-size: 34rpx;
  line-height: 46rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.row-date {
  margin-top: 2rpx;
  color: #657277;
  font-size: 24rpx;
  line-height: 34rpx;
}

.row-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.row-title {
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: 500;
}

.row-meta {
  margin-top: 4rpx;
  color: #657277;
  font-size: 26rpx;
  line-height: 36rpx;
}

.chevron {
  width: 36rpx;
  height: 36rpx;
  margin-left: 16rpx;
}

.done-icon {
  width: 88rpx;
  height: 88rpx;
  min-width: 88rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E6F0EB;
  border-radius: 50%;
}

.done-icon image {
  width: 48rpx;
  height: 48rpx;
}

.reminder-group--done .row-title {
  color: #657277;
}

.loading-state,
.error-state,
.empty-state {
  margin: 48rpx 32rpx;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border: 2rpx solid #DDE2E0;
  border-radius: 36rpx;
}

.loading-line {
  width: 100%;
  height: 88rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(90deg, #E7EBE9, #F4F6F5, #E7EBE9);
  background-size: 200% 100%;
  border-radius: 24rpx;
  animation: shimmer 1.4s ease infinite;
}

.loading-line--title {
  width: 40%;
  height: 36rpx;
  align-self: flex-start;
}

.error-state > image {
  width: 64rpx;
  height: 64rpx;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #DCE9EA;
  border-radius: 50%;
}

.empty-icon image {
  width: 52rpx;
  height: 52rpx;
}

.state-title {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.state-description {
  margin-top: 8rpx;
  color: #657277;
  text-align: center;
  font-size: 26rpx;
  line-height: 38rpx;
}

.retry-button {
  min-width: 200rpx;
  min-height: 88rpx;
  margin-top: 24rpx;
  padding: 16rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #315E6B;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 600;
  background: #DCE9EA;
  border-radius: 999rpx;
}

.retry-button image {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

button::after {
  border: 0;
}

@keyframes shimmer {
  to {
    background-position: -200% 0;
  }
}
