/* ===== 视频通话界面 ===== */
.call-page,
.incoming-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #FFFFFF;
  background: #111418;
}

.call-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.call-shade {
  position: absolute;
  left: 0;
  right: 0;
  pointer-events: none;
  z-index: 1;
}

.call-shade-top {
  top: 0;
  height: 360rpx;
  background: linear-gradient(180deg, rgba(12, 13, 15, 0.70) 0%, rgba(12, 13, 15, 0.30) 56%, rgba(12, 13, 15, 0) 100%);
}

.call-shade-bottom {
  bottom: 0;
  height: 620rpx;
  background: linear-gradient(0deg, rgba(8, 9, 10, 0.96) 0%, rgba(8, 9, 10, 0.72) 48%, rgba(8, 9, 10, 0) 100%);
}

.call-header {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 114rpx 42rpx 0;
  box-sizing: border-box;
}

.call-action {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.call-action-icon {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.94;
}

.call-identity {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 2rpx 18rpx 0;
  text-shadow: 0 2rpx 18rpx rgba(0, 0, 0, 0.45);
}

.call-name {
  font-size: 48rpx;
  line-height: 1.16;
  font-weight: 700;
  color: #FFFFFF;
}

.call-time {
  margin-top: 10rpx;
  font-size: 34rpx;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.92);
  font-variant-numeric: tabular-nums;
}

.call-status {
  margin-top: 8rpx;
  max-width: 360rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: rgba(255, 255, 255, 0.72);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.call-caption-layer {
  position: absolute;
  left: 42rpx;
  right: 42rpx;
  bottom: 420rpx;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.reminder-chip {
  max-width: 100%;
  min-height: 92rpx;
  padding: 18rpx 30rpx 18rpx 22rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 60rpx rgba(0, 0, 0, 0.18);
}

.reminder-pill-icon {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  transform: rotate(-35deg);
}

.reminder-pill-head,
.reminder-pill-tail {
  position: absolute;
  width: 58rpx;
  height: 30rpx;
  left: 0;
  border-radius: 30rpx 30rpx 0 0;
}

.reminder-pill-head {
  top: 0;
  background: linear-gradient(135deg, #FF6B5A 0%, #D73E32 100%);
}

.reminder-pill-tail {
  bottom: 0;
  background: linear-gradient(135deg, #FFFFFF 0%, #EDEAE4 100%);
  transform: rotate(180deg);
}

.reminder-chip-text {
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #6A3E2F;
  word-break: break-all;
}

.glass-panel,
.transcript-panel {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  background: rgba(20, 22, 25, 0.70);
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.24);
}

.transcript-panel {
  max-height: 330rpx;
  border-radius: 34rpx;
  padding: 22rpx;
  text-align: left;
}

.transcript-item {
  border-radius: 28rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.transcript-item:last-child {
  margin-bottom: 0;
}

.transcript-item-user {
  margin-left: 56rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
}

.transcript-item-assistant {
  margin-right: 30rpx;
  background: rgba(23, 24, 28, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.transcript-item-draft {
  opacity: 0.94;
}

.transcript-role {
  display: block;
  margin-bottom: 4rpx;
  font-size: 22rpx;
  line-height: 1.3;
}

.transcript-item-user .transcript-role {
  color: rgba(106, 62, 47, 0.64);
}

.transcript-item-assistant .transcript-role {
  color: rgba(255, 255, 255, 0.58);
}

.transcript-content {
  display: block;
  font-size: 30rpx;
  line-height: 1.52;
  word-break: break-all;
}

.transcript-item-user .transcript-content {
  color: #6A3E2F;
  font-weight: 600;
}

.transcript-item-assistant .transcript-content {
  color: #FFFFFF;
}

.transcript-anchor {
  width: 100%;
  height: 2rpx;
}

.call-prompt {
  border-radius: 34rpx;
  padding: 30rpx 34rpx;
  text-align: center;
}

.connecting-main-hint {
  display: block;
  font-size: 34rpx;
  color: #FFFFFF;
  font-weight: 700;
  line-height: 1.45;
}

.connecting-sub-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.70);
  line-height: 1.45;
}

.subtitle-hint {
  display: block;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.45;
}

.video-bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  padding: 0 46rpx calc(38rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.voice-state {
  min-height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.voice-state-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.74);
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot-listening {
  background: #5ED26A;
  box-shadow: 0 0 14rpx rgba(94, 210, 106, 0.78);
}

.status-dot-speaking {
  background: #FFB45C;
  box-shadow: 0 0 18rpx rgba(255, 180, 92, 0.88);
  animation: pulse-dot 1.2s ease-in-out infinite;
}

.status-dot-assistant {
  background: #FF7A59;
  box-shadow: 0 0 18rpx rgba(255, 122, 89, 0.88);
  animation: pulse-dot 1.2s ease-in-out infinite;
}

.status-dot-waiting {
  background: #FFD45C;
  box-shadow: 0 0 16rpx rgba(255, 212, 92, 0.78);
  animation: pulse-dot 1.4s ease-in-out infinite;
}

.waveform {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 4rpx -18rpx 30rpx;
  opacity: 0.92;
}

.wave-bar {
  width: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #FFD28A 0%, #FF704D 100%);
  box-shadow: 0 0 18rpx rgba(255, 112, 77, 0.68);
  transform-origin: center;
}

.waveform-active .wave-bar {
  animation: wave-breathe 1s ease-in-out infinite;
}

.wave-bar-1 { height: 16rpx; animation-delay: 0s; }
.wave-bar-2 { height: 22rpx; animation-delay: 0.05s; }
.wave-bar-3 { height: 30rpx; animation-delay: 0.1s; }
.wave-bar-4 { height: 20rpx; animation-delay: 0.15s; }
.wave-bar-5 { height: 38rpx; animation-delay: 0.2s; }
.wave-bar-6 { height: 52rpx; animation-delay: 0.25s; }
.wave-bar-7 { height: 64rpx; animation-delay: 0.3s; }
.wave-bar-8 { height: 44rpx; animation-delay: 0.35s; }
.wave-bar-9 { height: 28rpx; animation-delay: 0.4s; }
.wave-bar-10 { height: 18rpx; animation-delay: 0.45s; }
.wave-bar-11 { height: 24rpx; animation-delay: 0.5s; }
.wave-bar-12 { height: 36rpx; animation-delay: 0.55s; }
.wave-bar-13 { height: 50rpx; animation-delay: 0.6s; }
.wave-bar-14 { height: 42rpx; animation-delay: 0.65s; }
.wave-bar-15 { height: 26rpx; animation-delay: 0.7s; }
.wave-bar-16 { height: 20rpx; animation-delay: 0.75s; }
.wave-bar-17 { height: 30rpx; animation-delay: 0.8s; }
.wave-bar-18 { height: 18rpx; animation-delay: 0.85s; }
.wave-bar-19 { height: 14rpx; animation-delay: 0.9s; }

.control-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 0 10rpx;
}

.control-item {
  width: 168rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.control-circle {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.22);
}

.control-circle-light {
  background: rgba(255, 255, 255, 0.94);
}

.control-circle-danger {
  background: linear-gradient(180deg, #FF544A 0%, #E9302D 100%);
}

.control-circle-danger:active {
  transform: scale(0.97);
}

.control-icon {
  width: 64rpx;
  height: 64rpx;
}

.control-icon-phone {
  width: 76rpx;
  height: 76rpx;
}

.control-label {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.92);
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.40);
}

@keyframes pulse-dot {
  0%, 100% { transform: scale(1); opacity: 0.82; }
  50% { transform: scale(1.35); opacity: 1; }
}

@keyframes wave-breathe {
  0%, 100% { transform: scaleY(0.72); opacity: 0.76; }
  50% { transform: scaleY(1.08); opacity: 1; }
}

/* ===== 模拟来电界面 ===== */
.incoming-blur {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  background: rgba(8, 10, 12, 0.26);
}

.incoming-card {
  position: relative;
  z-index: 3;
  min-height: 52vh;
  padding: 210rpx 56rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  text-shadow: 0 2rpx 18rpx rgba(0, 0, 0, 0.42);
}

.incoming-label {
  font-size: 26rpx;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.72);
  letter-spacing: 2rpx;
}

.incoming-name {
  margin-top: 24rpx;
  font-size: 60rpx;
  line-height: 1.1;
  font-weight: 800;
  color: #FFFFFF;
}

.incoming-desc {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.78);
}

.incoming-reminder {
  margin-top: 54rpx;
  max-width: 100%;
  padding: 20rpx 30rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.16);
}

.incoming-reminder text {
  font-size: 30rpx;
  line-height: 1.4;
  color: #6A3E2F;
  font-weight: 700;
}

.incoming-actions {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(78rpx + env(safe-area-inset-bottom));
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 170rpx;
}

.incoming-action-group {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.incoming-control {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.24);
}

.incoming-control-decline {
  background: linear-gradient(180deg, #FF544A 0%, #E9302D 100%);
}

.incoming-control-accept {
  background: linear-gradient(180deg, #55D978 0%, #22B857 100%);
}

.incoming-control-icon {
  width: 74rpx;
  height: 74rpx;
}

.incoming-control-accept .incoming-control-icon {
  transform: rotate(180deg);
}

.incoming-btn-disabled {
  opacity: 0.58;
}

.incoming-action-label {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.88);
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.38);
}
