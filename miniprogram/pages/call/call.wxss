/* ===== 通话界面 ===== */
.call-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #2D2A26 0%, #1A1816 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 120rpx 40rpx 80rpx;
  box-sizing: border-box;
}

.timer-area {
  text-align: center;
}

.timer-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

.timer-text {
  display: block;
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 300;
  letter-spacing: 4rpx;
  margin-top: 8rpx;
}

/* 头像 */
.avatar-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.avatar-glow {
  position: absolute;
  top: -60rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 107, 74, 0.15) 0%, transparent 70%);
}

.avatar {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE8D0, #FFD0C0);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.avatar-emoji { font-size: 120rpx; }

.avatar-name {
  display: block;
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 700;
  margin-top: 24rpx;
}

.avatar-role {
  display: block;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 8rpx;
}

/* 字幕 */
.subtitle-area {
  width: 100%;
  min-height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.subtitle-box {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 30rpx 34rpx;
  width: 100%;
  text-align: center;
  box-sizing: border-box;
  overflow: hidden;
}

.transcript-scroll {
  max-height: 400rpx;
  text-align: left;
  box-sizing: border-box;
  width: 100%;
}

.transcript-item {
  border-radius: 18rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 14rpx;
}

.transcript-item:last-child {
  margin-bottom: 0;
}

.transcript-item-user {
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.transcript-item-assistant {
  background: rgba(255, 107, 74, 0.14);
  border: 1rpx solid rgba(255, 107, 74, 0.24);
}

.transcript-item-draft {
  opacity: 0.9;
}

.transcript-role {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.66);
  margin-bottom: 6rpx;
}

.transcript-content {
  display: block;
  font-size: 30rpx;
  color: #FFFFFF;
  line-height: 1.55;
  word-break: break-all;
}

.transcript-anchor {
  width: 100%;
  height: 2rpx;
}

.subtitle-ai {
  display: block;
  font-size: 32rpx;
  color: #ffffff;
  line-height: 1.6;
}

.connecting-main-hint {
  display: block;
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 600;
  line-height: 1.5;
  text-align: center;
}

.connecting-sub-hint {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  text-align: center;
}

.subtitle-user {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 12rpx;
}

.subtitle-hint {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.68);
}

.phase-steps {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.phase-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.phase-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  transition: all 0.2s ease;
}

.phase-dot-active {
  background: #FF8A65;
  box-shadow: 0 0 10rpx rgba(255, 138, 101, 0.7);
}

.phase-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

/* 底部操作 */
.bottom-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  width: 100%;
}

/* 状态卡片（非按钮） */
.status-card {
  width: 100%;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot-listening {
  background: #66BB6A;
  box-shadow: 0 0 10rpx rgba(102, 187, 106, 0.7);
}

.status-dot-speaking {
  background: #FF8A65;
  box-shadow: 0 0 12rpx rgba(255, 138, 101, 0.85);
  animation: pulse 1.4s ease-in-out infinite;
}

.status-dot-assistant {
  background: #FF7043;
  box-shadow: 0 0 12rpx rgba(255, 112, 67, 0.85);
  animation: pulse 1.3s ease-in-out infinite;
}

.status-dot-waiting {
  background: #FFD54F;
  box-shadow: 0 0 10rpx rgba(255, 213, 79, 0.75);
  animation: waiting-breathe 1.4s ease-in-out infinite;
}

.status-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.status-title {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.status-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

/* 挂断 */
.hangup-btn {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #E53935;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}

.hangup-btn:active { background: #C62828; }

.hangup-icon {
  font-size: 52rpx;
  transform: rotate(135deg);
}

.hangup-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.62);
  margin-top: 12rpx;
}

@keyframes pulse {
  0% { transform: scale(1); opacity: 0.7; }
  100% { transform: scale(1.45); opacity: 0.2; }
}

@keyframes waiting-breathe {
  0%, 100% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.1); opacity: 1; }
}

/* ===== 模拟来电界面 ===== */
.incoming-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1B3A2D 0%, #0F1F18 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 40rpx 120rpx;
  box-sizing: border-box;
}

.incoming-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.incoming-avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE8D0, #FFD0C0);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: incoming-pulse 2s ease-in-out infinite;
}

@keyframes incoming-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.3); }
  50% { box-shadow: 0 0 0 40rpx rgba(76, 175, 80, 0); }
}

.incoming-emoji { font-size: 100rpx; }

.incoming-name {
  display: block;
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 700;
  margin-top: 32rpx;
}

.incoming-desc {
  display: block;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 8rpx;
}

.incoming-ring-text {
  margin-top: 48rpx;
}

.incoming-ring-text text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 来电操作按钮 */
.incoming-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 160rpx;
}

.incoming-action-group {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.decline-btn {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #E53935;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.decline-btn text { transform: rotate(135deg); display: block; }
.decline-btn:active { background: #C62828; }

.accept-btn {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #4CAF50;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.accept-btn:active { background: #388E3C; }

.incoming-btn-disabled {
  opacity: 0.55;
}

.incoming-action-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 16rpx;
}
