page {
  width: 100%;
  height: 100%;
  background: #182022;
}

button {
  margin: 0;
  padding: 0;
  line-height: inherit;
  color: inherit;
  background: none;
  border-radius: 0;
}

button::after {
  display: none;
}

.call-page {
  position: relative;
  width: 100%;
  height: 100vh;
  min-height: 100%;
  overflow: hidden;
  color: #fff;
  background: #182022;
}

.media-layer,
.companion-media {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.companion-media {
  z-index: 1;
  opacity: 0;
  transition: opacity 220ms ease;
}

image.companion-media {
  opacity: 1;
}

video.companion-media.is-visible {
  z-index: 2;
  opacity: 1;
}

.top-shade,
.bottom-shade {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 3;
  pointer-events: none;
}

.top-shade {
  top: 0;
  height: 39%;
  background: linear-gradient(180deg, rgba(12, 18, 19, .8) 0%, rgba(12, 18, 19, .3) 58%, rgba(12, 18, 19, 0) 100%);
}

.bottom-shade {
  bottom: 0;
  height: 48%;
  background: linear-gradient(0deg, rgba(10, 16, 17, .94) 0%, rgba(10, 16, 17, .66) 45%, rgba(10, 16, 17, 0) 100%);
}

.incoming-header,
.call-header {
  position: absolute;
  top: 0;
  left: 36rpx;
  right: 36rpx;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.person-name {
  font-size: 52rpx;
  line-height: 68rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .3);
}

.incoming-purpose {
  max-width: 620rpx;
  margin-top: 12rpx;
  font-size: 34rpx;
  line-height: 50rpx;
  font-weight: 500;
}

.incoming-state,
.call-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
  padding: 12rpx 24rpx;
  color: rgba(255, 255, 255, .92);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 600;
  background: rgba(18, 24, 25, .56);
  border: 1rpx solid rgba(255, 255, 255, .18);
  border-radius: 999rpx;
  backdrop-filter: blur(16rpx);
}

.state-dot {
  width: 14rpx;
  height: 14rpx;
  flex: 0 0 auto;
  background: #77b4aa;
  border-radius: 50%;
}

.incoming-state:not(.is-answering) .state-dot,
.status-listening .state-dot {
  animation: breathe 1.6s ease-in-out infinite;
}

.status-warning {
  color: #fff1c9;
  background: rgba(99, 68, 16, .82);
}

.status-warning .state-dot {
  background: #e0ad4f;
}

.status-error {
  background: rgba(113, 29, 29, .82);
}

.status-error .state-dot {
  background: #ff8a8a;
}

.status-muted .state-dot {
  background: #d7dddb;
}

.call-time {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, .86);
  font-size: 30rpx;
  line-height: 42rpx;
  font-variant-numeric: tabular-nums;
}

.call-status {
  margin-top: 0;
}

.connection-detail {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, .78);
  font-size: 26rpx;
  line-height: 36rpx;
}

.call-progress {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(214rpx + env(safe-area-inset-bottom));
  z-index: 7;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  pointer-events: none;
}

.reminder-feedback {
  position: absolute;
  left: 64rpx;
  right: 64rpx;
  bottom: calc(458rpx + env(safe-area-inset-bottom));
  z-index: 7;
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 142rpx;
  padding: 24rpx 26rpx;
  color: #fff;
  background: rgba(18, 24, 25, .9);
  border: 1rpx solid rgba(255, 255, 255, .18);
  border-radius: 30rpx;
  box-sizing: border-box;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, .2);
  backdrop-filter: blur(22rpx);
  animation: feedback-in 220ms ease-out both;
}

.reminder-feedback.above-sheet {
  bottom: calc(58vh + 24rpx);
}

.feedback-failed {
  background: rgba(92, 31, 31, .92);
}

.feedback-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  flex: 0 0 auto;
  color: #fff;
  font-size: 38rpx;
  line-height: 66rpx;
  font-weight: 700;
  background: #3c7d65;
  border-radius: 50%;
}

.feedback-failed .feedback-icon {
  background: #c83f3f;
}

.feedback-icon image {
  width: 38rpx;
  height: 38rpx;
}

.feedback-spinner {
  width: 34rpx;
  height: 34rpx;
  border: 5rpx solid rgba(255, 255, 255, .35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin .85s linear infinite;
}

.feedback-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-wrap: wrap;
  align-items: baseline;
  column-gap: 16rpx;
}

.feedback-title {
  width: 100%;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
}

.feedback-schedule {
  color: #b7d7d1;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.feedback-item {
  color: rgba(255, 255, 255, .9);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 500;
}

.incoming-actions,
.call-controls {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 8;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding-bottom: calc(50rpx + env(safe-area-inset-bottom));
}

.incoming-actions {
  gap: 150rpx;
}

.incoming-action,
.control-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 136rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 600;
}

.incoming-action[disabled],
.control-item[disabled] {
  opacity: .5;
}

.incoming-action-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  height: 136rpx;
  margin-bottom: 18rpx;
  border-radius: 50%;
  box-sizing: border-box;
}

.decline .incoming-action-circle {
  background: rgba(255, 255, 255, .92);
}

.accept .incoming-action-circle {
  background: #315e6b;
  box-shadow: 0 12rpx 34rpx rgba(22, 57, 66, .34);
}

.incoming-action-icon {
  width: 60rpx;
  height: 60rpx;
}

.answering-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 6rpx solid rgba(255, 255, 255, .35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin .85s linear infinite;
}

.recent-subtitles {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(340rpx + env(safe-area-inset-bottom));
  z-index: 6;
  max-height: 224rpx;
  padding: 24rpx 28rpx;
  overflow: hidden;
  background: rgba(18, 24, 25, .82);
  border: 1rpx solid rgba(255, 255, 255, .14);
  border-radius: 32rpx;
  box-sizing: border-box;
  backdrop-filter: blur(20rpx);
}

.recent-line,
.transcript-line {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.recent-line + .recent-line,
.transcript-line + .transcript-line {
  margin-top: 14rpx;
}

.recent-line:nth-last-child(n + 3) {
  display: none;
}

.speaker-label {
  flex: 0 0 auto;
  padding-top: 2rpx;
  color: #a9d0c9;
  font-size: 27rpx;
  line-height: 46rpx;
  font-weight: 700;
}

.recent-text,
.transcript-text {
  flex: 1;
  min-width: 0;
  color: #fff;
  font-size: 32rpx;
  line-height: 46rpx;
  font-weight: 500;
}

.is-draft {
  opacity: .78;
}

.transcript-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 7;
  height: 58vh;
  padding: 14rpx 32rpx calc(224rpx + env(safe-area-inset-bottom));
  color: #fff;
  background: rgba(18, 24, 25, .96);
  border-radius: 40rpx 40rpx 0 0;
  box-sizing: border-box;
  backdrop-filter: blur(28rpx);
}

.sheet-handle {
  width: 76rpx;
  height: 8rpx;
  margin: 0 auto 14rpx;
  background: rgba(255, 255, 255, .36);
  border-radius: 999rpx;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
}

.sheet-title {
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 700;
}

.sheet-close {
  min-width: 88rpx;
  min-height: 64rpx;
  color: #b6d7d1;
  font-size: 28rpx;
  line-height: 64rpx;
  font-weight: 600;
  text-align: right;
}

.transcript-scroll {
  height: calc(58vh - 112rpx - 224rpx - env(safe-area-inset-bottom));
}

.transcript-line {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, .1);
}

.empty-transcript {
  padding: 56rpx 0;
  color: rgba(255, 255, 255, .62);
  font-size: 30rpx;
  line-height: 44rpx;
  text-align: center;
}

.call-controls {
  gap: 22rpx;
  padding-left: 20rpx;
  padding-right: 20rpx;
}

.failure-actions {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 0;
  z-index: 8;
  display: flex;
  gap: 24rpx;
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
}

.failure-button {
  flex: 1;
  height: 104rpx;
  color: #fff;
  font-size: 30rpx;
  line-height: 104rpx;
  font-weight: 700;
  border-radius: 28rpx;
}

.failure-button.secondary {
  background: rgba(255, 255, 255, .2);
  border: 1rpx solid rgba(255, 255, 255, .3);
}

.failure-button.primary {
  background: #315e6b;
}

.control-item {
  min-width: 112rpx;
  font-size: 24rpx;
  line-height: 34rpx;
}

.control-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 106rpx;
  height: 106rpx;
  margin-bottom: 12rpx;
  background: rgba(255, 255, 255, .18);
  border: 1rpx solid rgba(255, 255, 255, .22);
  border-radius: 50%;
  box-sizing: border-box;
  transition: background 180ms ease, transform 180ms ease;
}

.control-item.is-active .control-circle {
  background: #fff;
  border-color: #fff;
}

.control-item.is-active .control-icon {
  filter: none;
}

.control-item.hangup {
  margin: -10rpx 10rpx 0;
}

.hangup .control-circle {
  width: 126rpx;
  height: 126rpx;
  margin-bottom: 2rpx;
  background: #c83f3f;
  border-color: #c83f3f;
  box-shadow: 0 12rpx 28rpx rgba(116, 22, 22, .35);
}

.control-icon {
  width: 50rpx;
  height: 50rpx;
}

.hangup-icon {
  width: 58rpx;
  height: 58rpx;
}

@keyframes breathe {
  0%,
  100% {
    opacity: .55;
    transform: scale(.85);
  }
  50% {
    opacity: 1;
    transform: scale(1.18);
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes feedback-in {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
