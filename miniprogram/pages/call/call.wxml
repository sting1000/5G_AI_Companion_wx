<view class="call-page">
  <view class="media-layer">
    <image
      class="companion-media"
      src="{{companionPosterSrc}}"
      mode="aspectFill"
    />
    <video
      wx:if="{{companionIdleSrc}}"
      id="companion-idle"
      class="companion-media {{showIdleVideo ? 'is-visible' : ''}}"
      src="{{companionIdleSrc}}"
      object-fit="cover"
      loop="{{true}}"
      muted="{{true}}"
      controls="{{false}}"
      show-center-play-btn="{{false}}"
      picture-in-picture-mode=""
      bindplay="onCompanionIdlePlay"
      bindloadedmetadata="onCompanionIdleLoaded"
      binderror="onCompanionIdleError"
    />
    <video
      wx:if="{{companionSpeakingSrc}}"
      id="companion-speaking"
      class="companion-media {{showSpeakingVideo ? 'is-visible' : ''}}"
      src="{{companionSpeakingSrc}}"
      object-fit="cover"
      loop="{{true}}"
      muted="{{true}}"
      controls="{{false}}"
      show-center-play-btn="{{false}}"
      picture-in-picture-mode=""
      bindplay="onCompanionSpeakingPlay"
      bindloadedmetadata="onCompanionSpeakingLoaded"
      binderror="onCompanionSpeakingError"
    />
  </view>

  <view class="top-shade"></view>
  <view class="bottom-shade"></view>

  <block wx:if="{{showIncoming}}">
    <view class="incoming-header" style="padding-top: {{topInset + 24}}px;">
      <text class="person-name">小林</text>
      <text class="incoming-purpose">{{incomingReminderTitle ? '来提醒您' + incomingReminderTitle : '给您打来提醒电话'}}</text>
      <view class="incoming-state {{isIncomingAnswering ? 'is-answering' : ''}}">
        <view class="state-dot"></view>
        <text>{{incomingHint}}</text>
      </view>
    </view>

    <view class="incoming-actions">
      <button
        class="incoming-action decline"
        disabled="{{isIncomingAnswering}}"
        bindtap="onDecline"
        aria-label="拒绝来电"
      >
        <view class="incoming-action-circle">
          <image class="incoming-action-icon" src="/assets/icons/call-decline.svg" />
        </view>
        <text>拒绝</text>
      </button>
      <button
        class="incoming-action accept"
        disabled="{{isIncomingAnswering}}"
        bindtap="onAccept"
        aria-label="{{isIncomingAnswering ? '正在接听' : '接听来电'}}"
      >
        <view class="incoming-action-circle">
          <view wx:if="{{isIncomingAnswering}}" class="answering-spinner"></view>
          <image wx:else class="incoming-action-icon" src="/assets/icons/call-answer.svg" />
        </view>
        <text>{{isIncomingAnswering ? '正在接听' : (status === 'failed' ? '重新接听' : '接听')}}</text>
      </button>
    </view>
  </block>

  <block wx:else>
    <view class="call-header" style="padding-top: {{topInset + 4}}px;">
      <text class="person-name">小林</text>
      <text class="call-time">{{elapsedText}}</text>
    </view>

    <view class="call-progress" wx:if="{{!isTranscriptExpanded}}">
      <view class="call-status status-{{callStatusTone}}">
        <view class="state-dot"></view>
        <text>{{callStatusText}}</text>
      </view>
      <text wx:if="{{status === 'connecting'}}" class="connection-detail">{{connectionHint}}</text>
    </view>

    <view
      wx:if="{{reminderFeedback}}"
      class="reminder-feedback feedback-{{reminderFeedback.state}} {{isTranscriptExpanded ? 'above-sheet' : ''}}"
      aria-live="polite"
    >
      <view class="feedback-icon">
        <view wx:if="{{reminderFeedback.state === 'saving'}}" class="feedback-spinner"></view>
        <image wx:elif="{{reminderFeedback.state === 'saved'}}" src="/assets/icons/check-white.svg" />
        <text wx:else>!</text>
      </view>
      <view class="feedback-copy">
        <text class="feedback-title">
          {{reminderFeedback.state === 'saving' ? '正在记下来' : (reminderFeedback.state === 'saved' ? '已记下' : '没有记成功')}}
        </text>
        <text wx:if="{{reminderFeedback.scheduleText}}" class="feedback-schedule">{{reminderFeedback.scheduleText}}</text>
        <text class="feedback-item">{{reminderFeedback.state === 'failed' ? '请再说一次' : reminderFeedback.title}}</text>
      </view>
    </view>

    <view class="recent-subtitles" wx:if="{{!isTranscriptExpanded && !reminderFeedback && (recentTranscriptItems.length || currentUserDraft || currentAssistantDraft)}}">
      <view
        wx:for="{{recentTranscriptItems}}"
        wx:key="id"
        class="recent-line"
      >
        <text class="speaker-label">{{item.role === 'user' ? '您' : '小林'}}</text>
        <text class="recent-text">{{item.content}}</text>
      </view>
      <view class="recent-line is-draft" wx:if="{{currentUserDraft}}">
        <text class="speaker-label">您</text>
        <text class="recent-text">{{currentUserDraft}}</text>
      </view>
      <view class="recent-line is-draft" wx:if="{{currentAssistantDraft}}">
        <text class="speaker-label">小林</text>
        <text class="recent-text">{{currentAssistantDraft}}</text>
      </view>
    </view>

    <view class="transcript-sheet" wx:if="{{isTranscriptExpanded}}">
      <view class="sheet-handle"></view>
      <view class="sheet-header">
        <text class="sheet-title">通话字幕</text>
        <button class="sheet-close" bindtap="onCloseTranscript" aria-label="收起字幕">收起</button>
      </view>
      <scroll-view
        class="transcript-scroll"
        scroll-y
        scroll-into-view="{{transcriptAnchorId}}"
        scroll-top="{{transcriptScrollTop}}"
      >
        <view
          wx:for="{{transcriptItems}}"
          wx:key="id"
          id="{{item.id}}"
          class="transcript-line"
        >
          <text class="speaker-label">{{item.role === 'user' ? '您' : '小林'}}</text>
          <text class="transcript-text">{{item.content}}</text>
        </view>
        <view id="draft-user" class="transcript-line is-draft" wx:if="{{currentUserDraft}}">
          <text class="speaker-label">您</text>
          <text class="transcript-text">{{currentUserDraft}}</text>
        </view>
        <view id="draft-assistant" class="transcript-line is-draft" wx:if="{{currentAssistantDraft}}">
          <text class="speaker-label">小林</text>
          <text class="transcript-text">{{currentAssistantDraft}}</text>
        </view>
        <view class="empty-transcript" wx:if="{{!transcriptItems.length && !currentUserDraft && !currentAssistantDraft}}">
          字幕会在通话开始后显示
        </view>
      </scroll-view>
    </view>

    <view class="failure-actions" wx:if="{{status === 'failed'}}">
      <button class="failure-button secondary" bindtap="onHangup">结束</button>
      <button class="failure-button primary" bindtap="onRetryCall">重新呼叫</button>
    </view>

    <view class="call-controls" wx:else>
      <button
        class="control-item {{isMuted ? 'is-active' : ''}}"
        disabled="{{status !== 'connected'}}"
        bindtap="onToggleMute"
        aria-label="{{isMuted ? '打开麦克风' : '关闭麦克风'}}"
      >
        <view class="control-circle">
          <image class="control-icon" src="{{isMuted ? '/assets/icons/call-mic-off.svg' : '/assets/icons/call-mic.svg'}}" />
        </view>
        <text>{{isMuted ? '取消静音' : '静音'}}</text>
      </button>

      <button class="control-item hangup" bindtap="onHangup" aria-label="挂断电话">
        <view class="control-circle">
          <image class="control-icon hangup-icon" src="/assets/icons/call-hangup.svg" />
        </view>
        <text>挂断</text>
      </button>

      <button
        wx:if="{{speakerAvailable}}"
        class="control-item {{isSpeakerOn ? 'is-active' : ''}}"
        disabled="{{isSpeakerChanging}}"
        bindtap="onToggleSpeaker"
        aria-label="{{isSpeakerOn ? '关闭扬声器' : '打开扬声器'}}"
      >
        <view class="control-circle">
          <image class="control-icon" src="{{isSpeakerOn ? '/assets/icons/call-speaker.svg' : '/assets/icons/call-speaker-off.svg'}}" />
        </view>
        <text>{{isSpeakerOn ? '扬声器开' : '听筒'}}</text>
      </button>

      <button
        class="control-item {{isTranscriptExpanded ? 'is-active' : ''}}"
        bindtap="onToggleTranscript"
        aria-label="{{isTranscriptExpanded ? '收起字幕' : '展开字幕'}}"
      >
        <view class="control-circle">
          <image class="control-icon" src="{{isTranscriptExpanded ? '/assets/icons/call-subtitle-off.svg' : '/assets/icons/call-subtitle.svg'}}" />
        </view>
        <text>{{isTranscriptExpanded ? '收起字幕' : '字幕'}}</text>
      </button>
    </view>
  </block>
</view>
