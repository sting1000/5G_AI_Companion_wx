<view class="call-page" wx:if="{{!showIncoming}}">
  <!-- 计时器 -->
  <view class="timer-area">
    <text class="timer-label">{{status === 'connecting' ? connectionHint : '通话中'}}</text>
    <text class="timer-text">{{elapsedText}}</text>
  </view>

  <!-- 头像区 -->
  <view class="avatar-area">
    <view class="avatar-glow"></view>
    <view class="avatar">
      <text class="avatar-emoji">👧</text>
    </view>
    <text class="avatar-name">小林</text>
  </view>

  <!-- 字幕区 -->
  <view class="subtitle-area">
    <scroll-view class="subtitle-box transcript-scroll" scroll-y scroll-into-view="{{transcriptAnchorId}}" scroll-top="{{transcriptScrollTop}}" scroll-with-animation lower-threshold="48" bindscroll="onTranscriptScroll" bindscrolltolower="onTranscriptScrollToLower" wx:if="{{transcriptItems.length > 0 || currentUserDraft || currentAssistantDraft}}">
      <view
        wx:for="{{transcriptItems}}"
        wx:key="id"
        id="{{item.id}}"
        class="transcript-item transcript-item-{{item.role}}">
        <text class="transcript-role">{{item.role === 'user' ? '您' : '小林'}}</text>
        <text class="transcript-content">{{item.content}}</text>
      </view>
      <view class="transcript-item transcript-item-user transcript-item-draft" wx:if="{{currentUserDraft}}" id="draft-user">
        <text class="transcript-role">您</text>
        <text class="transcript-content">{{currentUserDraft}}</text>
      </view>
      <view class="transcript-item transcript-item-assistant transcript-item-draft" wx:if="{{currentAssistantDraft}}" id="draft-assistant">
        <text class="transcript-role">小林</text>
        <text class="transcript-content">{{currentAssistantDraft}}</text>
      </view>
      <view class="transcript-anchor" id="{{transcriptAnchorId}}"></view>
    </scroll-view>
    <view class="subtitle-box" wx:elif="{{status === 'connecting'}}">
      <text class="connecting-main-hint">{{connectionHint}}</text>
      <text class="connecting-sub-hint">请稍等，马上为您接通</text>
    </view>
    <view class="subtitle-box" wx:else>
      <text class="subtitle-hint">正在聆听，直接说话即可</text>
    </view>
  </view>

  <!-- 底部：声波指示 + 挂断 -->
  <view class="bottom-area">
    <view class="status-card">
      <view class="status-dot {{status === 'connecting' ? 'status-dot-waiting' : (isAssistantSpeaking ? 'status-dot-assistant' : (isSpeaking ? 'status-dot-speaking' : 'status-dot-listening'))}}"></view>
      <view class="status-copy">
        <text class="status-title">{{status === 'connecting' ? '连接中...' : (isAssistantSpeaking ? '小林正在回复' : (isSpeaking ? '您说话中' : '正在聆听'))}}</text>
        <text class="status-desc">{{status === 'connecting' ? connectionHint : (isAssistantSpeaking ? '请稍听，小林马上说完' : '免按键通话，直接说话即可')}}</text>
      </view>
    </view>

    <view class="hangup-btn" catchtap="onHangup">
      <text class="hangup-icon">📞</text>
    </view>
    <text class="hangup-label">挂断</text>
  </view>
</view>

<!-- 模拟来电界面 -->
<view class="incoming-page" wx:if="{{showIncoming}}">
  <view class="incoming-content">
    <view class="incoming-avatar">
      <text class="incoming-emoji">👧</text>
    </view>
    <text class="incoming-name">小林</text>
    <text class="incoming-desc">来电</text>
    <view class="incoming-ring-text">
      <text>{{incomingHint}}</text>
    </view>
  </view>
  <view class="incoming-actions">
    <view class="incoming-action-group">
      <view class="decline-btn {{isIncomingAnswering ? 'incoming-btn-disabled' : ''}}" catchtap="onDecline">
        <text>📞</text>
      </view>
      <text class="incoming-action-label">拒绝</text>
    </view>
    <view class="incoming-action-group">
      <view class="accept-btn {{isIncomingAnswering ? 'incoming-btn-disabled' : ''}}" catchtap="onAccept">
        <text>📞</text>
      </view>
      <text class="incoming-action-label">{{isIncomingAnswering ? '接听中' : '接听'}}</text>
    </view>
  </view>
</view>
