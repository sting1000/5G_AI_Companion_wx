<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-nav">
  </view>

  <view class="page-title">设置</view>

  <!-- 用户信息卡片 -->
  <view class="card user-profile-card">
    <view class="profile-left">
      <view class="user-avatar-large">
        <text>李</text>
      </view>
      <view class="user-info">
        <text class="user-name">李明</text>
        <text class="user-phone">138****8888</text>
      </view>
    </view>
    <view class="arrow-right">›</view>
  </view>

  <!-- 陪伴设置模块 -->
  <view class="section">
    <text class="section-title">陪伴设置</text>
    <view class="card list-card">
      <view class="list-item" bindtap="goOnboarding">
        <view class="item-left">
          <view class="item-icon bg-orange">👤</view>
          <view class="item-text">
            <text class="item-title">父母信息</text>
            <text class="item-desc">进入配置页修改资料</text>
          </view>
        </view>
        <view class="arrow-right">›</view>
      </view>

      <view class="list-item">
        <view class="item-left">
          <view class="item-icon bg-red">💬</view>
          <view class="item-text">
            <text class="item-title">AI角色设置</text>
            <text class="item-desc">更换陪伴角色</text>
          </view>
        </view>
        <view class="arrow-right">›</view>
      </view>

      <view class="list-item">
        <view class="item-left">
          <view class="item-icon bg-orange">🕒</view>
          <view class="item-text">
            <text class="item-title">通话计划</text>
            <text class="item-desc">调整通话时间和频率</text>
          </view>
        </view>
        <view class="arrow-right">›</view>
      </view>

      <view class="list-item no-border">
        <view class="item-left">
          <view class="item-icon bg-red">🤍</view>
          <view class="item-text">
            <text class="item-title">关怀事件</text>
            <text class="item-desc">管理特殊日期</text>
          </view>
        </view>
        <view class="arrow-right">›</view>
      </view>
    </view>
  </view>

  <!-- 兴趣内容推荐模块 -->
  <view class="section">
    <text class="section-title">兴趣内容推荐</text>
    <view class="card list-card">
      <view class="list-item no-border">
        <view class="item-left full-width">
          <view class="item-text">
            <text class="item-title">允许在通话中推荐内容</text>
            <text class="item-desc">AI发现兴趣后，在日常通话中自然提及相关话题</text>
          </view>
        </view>
        <switch checked="{{recommendEnabled}}" color="#07C160" bindchange="onRecommendChange"/>
      </view>
    </view>
  </view>

  <!-- 系统模块 -->
  <view class="section">
    <text class="section-title">系统</text>
    <view class="card list-card">
      <view class="list-item">
        <view class="item-left">
          <view class="item-icon bg-gray">🔔</view>
          <view class="item-text">
            <text class="item-title">通知设置</text>
            <text class="item-desc">管理推送通知</text>
          </view>
        </view>
        <view class="arrow-right">›</view>
      </view>

      <view class="list-item no-border">
        <view class="item-left">
          <view class="item-icon bg-gray">🛡️</view>
          <view class="item-text">
            <text class="item-title">隐私与安全</text>
            <text class="item-desc">数据保护设置</text>
          </view>
        </view>
        <view class="arrow-right">›</view>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">测试工具</text>
    <view class="card list-card">
      <view class="list-item no-border" bindtap="onClearAllTestData">
        <view class="item-left">
          <view class="item-icon bg-red">🗑️</view>
          <view class="item-text">
            <text class="item-title">清空本地测试数据</text>
            <text class="item-desc">重置配置、通话记录、记忆缓存并返回配置页</text>
          </view>
        </view>
        <view class="arrow-right">›</view>
      </view>
    </view>
  </view>

  <!-- 开发调试：记忆面板（仅开发环境显示） -->
  <view class="section" wx:if="{{isDevMode}}">
    <text class="section-title">开发调试（记忆）</text>
    <view class="card list-card debug-card">
      <view class="debug-header">
        <text class="debug-title">当前老人：{{currentElderTitle}}</text>
        <view class="debug-actions">
          <text class="debug-link" bindtap="refreshMemoryDebug">刷新</text>
          <text class="debug-link danger" bindtap="onResetCurrentMemory">重置</text>
        </view>
      </view>
      <text class="debug-json" selectable>{{memoryDebugText}}</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-btn" bindtap="onLogout">
    <text>↪ 退出登录</text>
  </view>
</view>
