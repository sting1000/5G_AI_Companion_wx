<view class="settings-page">
  <view class="page-nav" style="padding-top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px;">
    <button class="nav-back" bindtap="goBack" aria-label="返回">
      <image src="/assets/icons/elder-back.svg" />
    </button>
    <text class="nav-title">设置</text>
    <view class="nav-spacer"></view>
  </view>

  <scroll-view class="settings-scroll" scroll-y>
    <view class="page-heading">
      <text class="heading-title">叮嘱设置</text>
      <text class="heading-desc">称呼和权限有变化时，可以在这里调整</text>
    </view>

    <view class="settings-group">
      <button class="setting-row" bindtap="editPreferredAddress">
        <view class="setting-icon">
          <image src="/assets/icons/settings-address.svg" />
        </view>
        <view class="setting-copy">
          <text class="setting-title">小林怎么称呼我</text>
          <text class="setting-desc">{{preferredAddress}}</text>
        </view>
        <image class="row-chevron" src="/assets/icons/chevron-right.svg" />
      </button>

      <button class="setting-row" bindtap="recoverMicrophone" disabled="{{microphoneBusy}}">
        <view class="setting-icon">
          <image src="/assets/icons/microphone.svg" />
        </view>
        <view class="setting-copy">
          <text class="setting-title">麦克风权限</text>
          <text class="setting-desc">{{microphoneBusy ? '正在检查…' : microphoneText}}</text>
        </view>
        <image class="row-chevron" src="/assets/icons/chevron-right.svg" />
      </button>

      <button class="setting-row" bindtap="recoverNotification" disabled="{{notificationBusy}}">
        <view class="setting-icon">
          <image src="/assets/icons/notification.svg" />
        </view>
        <view class="setting-copy">
          <text class="setting-title">通知权限</text>
          <text class="setting-desc">{{notificationBusy ? '正在检查…' : notificationText}}</text>
        </view>
        <image class="row-chevron" src="/assets/icons/chevron-right.svg" />
      </button>
    </view>

    <view class="settings-group secondary-group">
      <button class="setting-row" bindtap="openAbout">
        <view class="setting-icon">
          <image src="/assets/icons/settings-about.svg" />
        </view>
        <view class="setting-copy">
          <text class="setting-title">关于叮嘱</text>
          <text class="setting-desc">了解产品用途</text>
        </view>
        <image class="row-chevron" src="/assets/icons/chevron-right.svg" />
      </button>

      <button class="setting-row" bindtap="openPrivacy">
        <view class="setting-icon">
          <image src="/assets/icons/settings-privacy.svg" />
        </view>
        <view class="setting-copy">
          <text class="setting-title">隐私说明</text>
          <text class="setting-desc">查看微信隐私保护指引</text>
        </view>
        <image class="row-chevron" src="/assets/icons/chevron-right.svg" />
      </button>
    </view>
  </scroll-view>
</view>
