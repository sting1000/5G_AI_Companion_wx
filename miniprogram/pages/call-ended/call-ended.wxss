page {
  min-height: 100%;
  background: #f3f4f2;
}

button {
  margin: 0;
  padding: 0;
  line-height: inherit;
  background: none;
}

button::after {
  display: none;
}

.ended-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  color: #1d282b;
  background:
    radial-gradient(circle at 50% 16%, rgba(49, 94, 107, .09), transparent 34%),
    #f3f4f2;
  box-sizing: border-box;
}

.ended-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  color: #315e6b;
  font-size: 30rpx;
  line-height: 44px;
  font-weight: 700;
  box-sizing: content-box;
}

.ended-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 40rpx 40rpx;
  box-sizing: border-box;
}

.success-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  margin-bottom: 38rpx;
  background: #3c7d65;
  border-radius: 50%;
  box-shadow: 0 18rpx 40rpx rgba(38, 91, 72, .18);
}

.success-mark image {
  width: 62rpx;
  height: 62rpx;
}

.ended-title {
  font-size: 52rpx;
  line-height: 68rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.ended-duration {
  margin-top: 12rpx;
  color: #657277;
  font-size: 30rpx;
  line-height: 44rpx;
}

.saved-section {
  width: 100%;
  margin-top: 68rpx;
}

.section-label {
  display: block;
  margin: 0 8rpx 18rpx;
  color: #657277;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 600;
}

.saved-reminder {
  display: flex;
  flex-direction: column;
  padding: 30rpx 32rpx;
  background: #fff;
  border: 1rpx solid #dde2e0;
  border-radius: 30rpx;
  box-shadow: 0 12rpx 34rpx rgba(30, 48, 52, .05);
}

.saved-reminder + .saved-reminder {
  margin-top: 16rpx;
}

.saved-time {
  color: #3c7d65;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.saved-title {
  margin-top: 6rpx;
  font-size: 36rpx;
  line-height: 50rpx;
  font-weight: 600;
}

.record-link {
  min-width: 240rpx;
  min-height: 88rpx;
  margin-top: 34rpx;
  color: #315e6b;
  font-size: 28rpx;
  line-height: 88rpx;
  font-weight: 600;
  text-align: center;
}

.ended-footer {
  flex: 0 0 auto;
  padding: 24rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
}

.today-button {
  width: 100%;
  height: 112rpx;
  color: #fff;
  font-size: 32rpx;
  line-height: 112rpx;
  font-weight: 700;
  background: #315e6b;
  border-radius: 32rpx;
  box-shadow: 0 16rpx 36rpx rgba(34, 75, 85, .2);
}
