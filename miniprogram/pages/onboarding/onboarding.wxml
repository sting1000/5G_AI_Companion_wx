<view class="page">
  <view class="header">
    <text class="title">为父母配置AI陪伴</text>
    <text class="subtitle">只需填写基本信息，2分钟开始</text>
  </view>

  <!-- 角色展示 -->
  <view class="card role-card">
    <view class="role-avatar">👩</view>
    <view class="role-info">
      <text class="role-name">小林 · 贴心晚辈</text>
      <text class="role-desc">温柔体贴的邻家女孩</text>
    </view>
  </view>

  <!-- 配置表单 -->
  <view class="card form-card">
    <view class="form-item">
      <text class="label">父母姓名</text>
      <view class="name-row">
        <input
          class="input name-input"
          placeholder="请输入姓名"
          value="{{parentName}}"
          bindinput="onInputName"
        />
        <picker
          class="title-picker"
          mode="selector"
          range="{{titleOptions}}"
          value="{{titleIndex}}"
          bindchange="onTitleChange"
        >
          <view class="picker-value">{{titleSuffix}} ▾</view>
        </picker>
      </view>
      <text class="hint" wx:if="{{parentName}}">小林将称呼为「{{parentName[0]}}{{titleSuffix}}」</text>
    </view>

    <view class="form-item">
      <text class="label">手机号码</text>
      <input
        class="input"
        type="number"
        placeholder="请输入手机号"
        maxlength="11"
        value="{{phone}}"
        bindinput="onInputPhone"
      />
    </view>
  </view>

  <!-- 隐私提示 -->
  <view class="privacy-tip">
    <text>🔒 数据加密存储，仅用于AI陪伴服务</text>
  </view>

  <!-- 提交按钮 -->
  <button class="btn-primary submit-btn" bindtap="onSubmit">
    开始陪伴 ✓
  </button>
</view>
