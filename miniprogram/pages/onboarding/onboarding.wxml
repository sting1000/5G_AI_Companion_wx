<view class="container">
  <view class="header">
    <text class="page-title">为父母配置AI陪伴</text>
    <text class="page-subtitle">填写父母的基本信息，帮助AI更好地陪伴他们</text>
  </view>

  <view class="form-content">
    <view class="card form-card">
      <view class="form-item">
        <view class="label-row">
          <text class="label">父母姓名</text>
          <text class="field-required">必填</text>
        </view>
        <view class="name-row">
          <input class="input name-input"
            placeholder="请输入姓名"
            value="{{parentName}}"
            bindinput="onNameInput" />
          <picker mode="selector"
            range="{{titleOptions}}"
            value="{{titleIndex}}"
            bindchange="onTitleChange">
            <view class="picker-value">{{titleOptions[titleIndex]}} ▾</view>
          </picker>
        </view>
        <text class="field-error" wx:if="{{errors.parentName}}">{{errors.parentName}}</text>
      </view>

      <view class="form-item">
        <view class="label-row">
          <text class="label">手机号码</text>
          <text class="field-optional">选填</text>
        </view>
        <input class="input"
          type="number"
          placeholder="请输入11位手机号"
          value="{{phone}}"
          bindinput="onPhoneInput" />
        <text class="field-error" wx:if="{{errors.phone}}">{{errors.phone}}</text>
      </view>
    </view>

    <view class="card form-card">
      <view class="form-item">
        <view class="label-row">
          <text class="label">兴趣爱好</text>
          <text class="field-optional">选填</text>
        </view>
        <view class="tags-container">
          <text wx:for="{{interestTags}}"
            wx:key="name"
            class="interest-tag {{item.selected ? 'active' : ''}}"
            data-idx="{{index}}"
            catchtap="toggleInterest">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="card form-card">
      <view class="form-item">
        <view class="label-row">
          <text class="label">健康情况备注</text>
          <text class="field-optional">选填</text>
        </view>
        <textarea class="textarea"
          placeholder="例如：膝盖不好，高血压"
          value="{{health}}"
          bindinput="onHealthInput" />
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="btn btn-primary full-width" bindtap="nextStep">完成配置</button>
  </view>
</view>
