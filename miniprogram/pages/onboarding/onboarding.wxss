.container {
  min-height: 100vh;
  background-color: #F8F9FA;
  display: flex;
  flex-direction: column;
}

/* 头部 */
.header {
  padding: 88rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #666;
}

.form-content {
  flex: 1;
  padding-bottom: 200rpx;
  overflow: visible;
}

/* 卡片 */
.card {
  background: white;
  border-radius: 24rpx;
  margin: 0 40rpx 32rpx;
  padding: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.label-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.field-required,
.field-optional {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.field-required {
  color: #FF6B4A;
  background-color: #FFF1ED;
}

.field-optional {
  color: #667085;
  background-color: #F2F4F7;
}

.field-error {
  margin-top: 12rpx;
  display: block;
  font-size: 24rpx;
  color: #E23A3A;
}

.label-with-icon {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.input {
  background-color: #F8F9FA;
  height: 88rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}

.name-row {
  display: flex;
  gap: 16rpx;
}

.name-input {
  flex: 1;
}

picker {
  background-color: #F8F9FA;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  min-width: 160rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #333;
}

/* 兴趣标签 */
.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.interest-tag {
  background-color: #F8F9FA;
  color: #666;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
}

.interest-tag.active {
  background-color: #FF6B4A;
  color: white;
}

.textarea {
  background-color: #F8F9FA;
  width: auto;
  min-height: 160rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 40rpx 64rpx;
  background: white;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
  z-index: 20;
}

.btn {
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
}

.btn-secondary {
  flex: 1;
  background-color: #FFF;
  color: #333;
  border: 2rpx solid #E0E0E0;
}

.btn-primary {
  flex: 1;
  background-color: #FF6B4A;
  color: white;
}

.full-width {
  flex: 1;
}
