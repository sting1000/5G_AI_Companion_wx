page {
  height: 100%;
  background: #f3f4f2;
}

button {
  margin: 0;
  padding: 0;
  line-height: inherit;
  background: none;
}

button::after {
  display: none;
}

.records-page {
  display: flex;
  height: 100vh;
  flex-direction: column;
  color: #1d282b;
  background:
    radial-gradient(circle at 94% 4%, rgba(49, 94, 107, .08), transparent 27%),
    #f3f4f2;
}

.page-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 0 0 auto;
  padding-left: 24rpx;
  padding-right: 24rpx;
  box-sizing: content-box;
}

.nav-back,
.nav-spacer {
  width: 88rpx;
  height: 88rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back image {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
}

.records-scroll {
  flex: 1;
  min-height: 0;
}

.page-heading {
  padding: 42rpx 40rpx 34rpx;
}

.heading-title {
  display: block;
  font-size: 44rpx;
  line-height: 58rpx;
  font-weight: 700;
}

.heading-desc {
  display: block;
  margin-top: 10rpx;
  color: #657277;
  font-size: 28rpx;
  line-height: 42rpx;
}

.record-list {
  margin: 0 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #dde2e0;
  border-radius: 32rpx;
  box-shadow: 0 12rpx 36rpx rgba(30, 48, 52, .05);
}

.record-row {
  display: flex;
  width: 100%;
  min-height: 146rpx;
  align-items: center;
  padding: 24rpx 26rpx;
  color: #1d282b;
  text-align: left;
  box-sizing: border-box;
}

.record-row + .record-row {
  border-top: 1rpx solid #e7ebe9;
}

.record-date-block {
  display: flex;
  width: 132rpx;
  flex: 0 0 auto;
  flex-direction: column;
}

.record-date {
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 700;
}

.record-time {
  margin-top: 4rpx;
  color: #657277;
  font-size: 26rpx;
  line-height: 36rpx;
  font-variant-numeric: tabular-nums;
}

.record-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  padding-left: 20rpx;
}

.record-duration {
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 600;
}

.record-status {
  margin-top: 6rpx;
  color: #657277;
  font-size: 25rpx;
  line-height: 36rpx;
}

.status-pending {
  color: #9a6a18;
}

.status-failed {
  color: #a63838;
}

.row-chevron {
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 auto;
  margin-left: 14rpx;
}

.state-card {
  display: flex;
  margin: 24rpx 32rpx 0;
  padding: 70rpx 40rpx 44rpx;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: #fff;
  border: 1rpx solid #dde2e0;
  border-radius: 32rpx;
}

.empty-mark {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 26rpx;
  background: #e4eeee;
  border-radius: 50%;
}

.empty-mark image {
  width: 52rpx;
  height: 52rpx;
}

.state-title {
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 700;
}

.state-desc {
  max-width: 530rpx;
  margin-top: 14rpx;
  color: #657277;
  font-size: 28rpx;
  line-height: 44rpx;
}

.state-action {
  min-width: 260rpx;
  height: 96rpx;
  margin-top: 36rpx;
  color: #fff;
  font-size: 30rpx;
  line-height: 96rpx;
  font-weight: 700;
  background: #315e6b;
  border-radius: 28rpx;
}
