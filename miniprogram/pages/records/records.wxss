.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF7EE 0%, #F6F2EC 58%, #FFFDF9 100%);
  padding-bottom: 40rpx;
}

/* 顶部自定义导航栏 */
.custom-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 100rpx 40rpx 20rpx;
  background: transparent;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.icon-avatar {
  width: 64rpx;
  height: 64rpx;
  background-color: #FF6B4A;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: white;
  font-size: 32rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.bell-icon {
  position: relative;
  font-size: 40rpx;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background-color: #FF3B30;
  color: white;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 20rpx;
  min-width: 24rpx;
  text-align: center;
}

.user-avatar-small {
  width: 64rpx;
  height: 64rpx;
  background-color: #FFE5D9;
  color: #FF6B4A;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-weight: bold;
}

.page-title {
  font-size: 48rpx;
  font-weight: bold;
  padding: 20rpx 40rpx 32rpx;
  color: #2D2A26;
}

/* Segmented Control */
.segment-control {
  display: flex;
  background: rgba(255, 255, 255, 0.88);
  margin: 0 40rpx 32rpx;
  border-radius: 20rpx;
  padding: 8rpx;
  box-shadow: 0 14rpx 40rpx rgba(75, 68, 58, 0.07);
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #8A8580;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.segment-item.active {
  background: linear-gradient(135deg, #FF7A59 0%, #E9503D 100%);
  color: white;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(233, 80, 61, 0.22);
}

/* 卡片通用类 */
.card {
  background: rgba(255, 255, 255, 0.90);
  border-radius: 28rpx;
  margin: 0 40rpx 32rpx;
  box-shadow: 0 14rpx 46rpx rgba(75, 68, 58, 0.08);
  padding: 32rpx;
}

/* Stats Card */
.stats-card {
  display: flex;
}

.stat-item {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stat-item:first-child {
  padding-right: 32rpx;
}

.stat-item:last-child {
  padding-left: 32rpx;
  position: relative;
}

.stat-item:last-child::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10%;
  height: 80%;
  width: 1rpx;
  background-color: #EEE;
}

.stat-label {
  font-size: 28rpx;
  color: #8A8580;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #2D2A26;
}

.section-title {
  font-size: 28rpx;
  color: #8A8580;
  margin: 0 40rpx 16rpx;
  display: block;
}

/* Record Item */
.record-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 30rpx;
}

.record-stamp {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #FF996D 0%, #E9503D 100%);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.44), 0 12rpx 28rpx rgba(233, 80, 61, 0.18);
}

.record-stamp::after {
  content: '';
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.58);
}

.record-stamp-text {
  position: relative;
  z-index: 1;
  font-size: 34rpx;
  line-height: 84rpx;
  font-weight: 900;
  color: #FFFFFF;
  text-align: center;
  text-shadow: 0 2rpx 6rpx rgba(95, 43, 26, 0.22);
}

.mood-stamp-happy {
  background: linear-gradient(135deg, #FFB75A 0%, #FF765B 100%);
}

.mood-stamp-calm {
  background: linear-gradient(135deg, #FF996D 0%, #E9503D 100%);
}

.mood-stamp-low {
  background: linear-gradient(135deg, #A8A19A 0%, #6F625B 100%);
}

.mood-stamp-anxious {
  background: linear-gradient(135deg, #E07B59 0%, #A73F34 100%);
}

.mood-stamp-pending {
  background: linear-gradient(135deg, #D1A266 0%, #9D7538 100%);
}

.mood-stamp-missed {
  background: linear-gradient(135deg, #B8B0AA 0%, #7E7670 100%);
}

.missed-icon {
  color: #FF3B30;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-date {
  font-size: 30rpx;
  color: #2D2A26;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.record-desc {
  font-size: 26rpx;
  color: #8A8580;
}

/* Status Tag */
.status-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
}

.status-missed {
  color: #FF3B30;
  background-color: rgba(255, 59, 48, 0.1);
}

.status-summary {
  color: #E9503D;
  font-weight: 700;
}

.status-pending {
  color: #9A6700;
  background-color: #FFF8DB;
}

.status-failed {
  color: #B42318;
  background-color: #FFECEB;
}

/* Content Recommendations */
.content-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.content-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.content-date {
  font-size: 26rpx;
  color: #999;
}

.tag-pending {
  background-color: #FFF3E0;
  color: #FF9800;
}

.tag-viewed {
  background-color: #E8F5E9;
  color: #4CAF50;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.tag-viewed::before {
  content: '✓';
}

.tag-rejected {
  background-color: #F5F5F5;
  color: #999;
}

.content-tags {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.topic-tag {
  background-color: #FFE5D9;
  color: #FF6B4A;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.content-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}
