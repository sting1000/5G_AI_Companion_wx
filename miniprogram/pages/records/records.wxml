<view class="records-page">
  <view class="page-nav" style="padding-top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px;">
    <button class="nav-back" bindtap="goBack" aria-label="返回">
      <image src="/assets/icons/elder-back.svg" />
    </button>
    <text class="nav-title">通话记录</text>
    <view class="nav-spacer"></view>
  </view>

  <scroll-view class="records-scroll" scroll-y>
    <view class="page-heading">
      <text class="heading-title">和小林聊过的电话</text>
      <text class="heading-desc">点开一条，可以查看当时保存的通话内容</text>
    </view>

    <view wx:if="{{hasLoadError}}" class="state-card">
      <text class="state-title">通话记录暂时没有加载出来</text>
      <text class="state-desc">您可以回到今天，稍后再试一次。</text>
      <button class="state-action" bindtap="goToday">回到今天</button>
    </view>

    <view wx:elif="{{!hasRecords}}" class="state-card">
      <view class="empty-mark">
        <image src="/assets/icons/elder-phone.svg" />
      </view>
      <text class="state-title">还没有通话记录</text>
      <text class="state-desc">和小林聊过一次后，通话内容会保存在这里。</text>
      <button class="state-action" bindtap="goToday">回到今天</button>
    </view>

    <view wx:else class="record-list">
      <button
        wx:for="{{records}}"
        wx:key="id"
        class="record-row"
        bindtap="goSummary"
        data-id="{{item.id}}"
      >
        <view class="record-date-block">
          <text class="record-date">{{item.dateText}}</text>
          <text class="record-time">{{item.timeText}}</text>
        </view>
        <view class="record-copy">
          <text class="record-duration">{{item.missed ? '提醒电话' : '通话 ' + item.durationText}}</text>
          <text class="record-status status-{{item.summaryState}}">{{item.summaryStatusText}}</text>
        </view>
        <image class="row-chevron" src="/assets/icons/chevron-right.svg" />
      </button>
    </view>
  </scroll-view>
</view>
