<view class="summary-page">
  <view class="page-nav" style="padding-top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px;">
    <button class="nav-back" bindtap="goBack" aria-label="返回">
      <image src="/assets/icons/elder-back.svg" />
    </button>
    <text class="nav-title">通话内容</text>
    <view class="nav-spacer"></view>
  </view>

  <scroll-view class="summary-scroll" scroll-y>
    <view wx:if="{{loadError}}" class="state-card">
      <text class="state-title">暂时没有读取成功</text>
      <text class="state-desc">通话记录还在，请稍后再试一次。</text>
      <button class="state-action" bindtap="reloadRecord">重新读取</button>
    </view>

    <view wx:elif="{{notFound}}" class="state-card">
      <text class="state-title">没有找到这条通话记录</text>
      <text class="state-desc">这条记录可能已经不存在，请返回通话记录页。</text>
      <button class="state-action" bindtap="goBack">返回通话记录</button>
    </view>

    <block wx:elif="{{record}}">
      <view class="record-heading">
        <text class="record-date">{{record.date}}</text>
        <text class="record-duration">和小林聊了 {{record.durationText}}</text>
      </view>

      <view class="summary-card state-{{record.summaryState}}">
        <view class="summary-card-header">
          <text class="card-title">本次摘要</text>
          <text class="status-label">{{record.summaryStateText}}</text>
        </view>
        <text class="summary-copy">{{record.summaryMessage}}</text>
        <button
          wx:if="{{record.summaryState === 'pending' || record.summaryState === 'failed'}}"
          class="refresh-action"
          bindtap="reloadRecord"
        >
          刷新状态
        </button>
      </view>

      <view class="transcript-card">
        <text class="card-title">通话字幕</text>
        <view wx:if="{{record.hasTranscript}}" class="transcript-list">
          <view
            wx:for="{{record.transcript}}"
            wx:key="id"
            class="transcript-row role-{{item.role}}"
          >
            <text class="speaker">{{item.speaker}}</text>
            <text class="transcript-copy">{{item.content}}</text>
          </view>
        </view>
        <view wx:else class="empty-transcript">
          <text>{{record.missed ? '这次电话没有接通，因此没有通话内容。' : '这次没有保存到可查看的字幕。'}}</text>
        </view>
      </view>
    </block>
  </scroll-view>
</view>
