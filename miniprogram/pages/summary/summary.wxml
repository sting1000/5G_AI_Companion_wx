<view class="summary-page">
  <view class="summary-nav">
    <view class="nav-back" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <text class="nav-title">通话复盘</text>
    <view class="nav-placeholder"></view>
  </view>

  <scroll-view class="scroll-content" scroll-y>
    <block wx:if="{{notFound}}">
      <view class="empty-state">
        <text>未找到通话记录</text>
      </view>
    </block>

    <block wx:elif="{{record}}">
      <view class="summary-hero">
        <view class="hero-topline">
          <text class="hero-kicker">AI SUMMARY</text>
          <view class="summary-state {{record.summaryStateClass}}">
            <text>{{record.summaryStateText}}</text>
          </view>
        </view>
        <text class="hero-title">小林已整理本次陪伴</text>
        <text class="hero-date">{{record.date}}</text>
        <view class="hero-metrics">
          <view class="metric-block">
            <text class="metric-value">{{record.durationText}}</text>
            <text class="metric-label">通话时长</text>
          </view>
          <view class="metric-divider"></view>
          <view class="metric-block">
            <text class="metric-value">{{record.moodLabel || '平静'}}</text>
            <text class="metric-label">情绪状态</text>
          </view>
          <view class="metric-divider"></view>
          <view class="metric-block">
            <text class="metric-value">{{record.topicCount}}</text>
            <text class="metric-label">识别话题</text>
          </view>
        </view>
      </view>

      <view class="mood-card">
        <view class="mood-orb {{record.moodToneClass}}">
          <text>{{record.moodLabel || '平静'}}</text>
        </view>
        <view class="mood-copy">
          <text class="section-title">情绪观察</text>
          <text class="section-desc">本次通话情绪评分 {{record.moodScore}}/5，适合用温和、简短的方式继续关心。</text>
          <view class="mood-track">
            <view class="mood-fill" style="width: {{record.moodPercent}}%;"></view>
          </view>
        </view>
      </view>

      <view class="insight-card">
        <view class="section-header">
          <text class="section-title">AI 概要</text>
          <text class="section-tag">可转发给家人</text>
        </view>
        <view class="summary-status status-pending" wx:if="{{record.summaryStatus === 'pending'}}">通话内容已保存，AI 正在整理摘要...</view>
        <view class="summary-status status-failed" wx:if="{{record.summaryStatus === 'failed'}}">{{record.summaryError || '摘要生成失败，请稍后重试'}}</view>
        <text class="summary-text" wx:if="{{record.summary}}">{{record.summary}}</text>
        <text class="summary-text summary-placeholder" wx:elif="{{record.summaryStatus === 'pending'}}">小林正在提炼本次通话重点，请稍后刷新。</text>
        <text class="summary-text summary-placeholder" wx:elif="{{record.summaryStatus === 'failed'}}">本次摘要暂不可用，但通话记录已保留。</text>
        <text class="summary-text summary-placeholder" wx:else>通话时间较短，暂无摘要。</text>
      </view>

      <view class="insight-card" wx:if="{{record.hasHighlights}}">
        <view class="section-header">
          <text class="section-title">重要提及</text>
          <text class="section-tag">{{record.highlightCount}} 条</text>
        </view>
        <view class="highlight-list">
          <view class="highlight-item" wx:for="{{record.highlights}}" wx:key="*this">
            <view class="highlight-index">{{index + 1}}</view>
            <text class="highlight-text">{{item}}</text>
          </view>
        </view>
      </view>

      <view class="insight-card" wx:if="{{record.hasTopics}}">
        <view class="section-header">
          <text class="section-title">对话信号</text>
          <text class="section-tag">{{record.signalTitle || '兴趣信号'}}</text>
        </view>
        <view class="signal-tags">
          <text class="signal-tag" wx:for="{{record.topics}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="signal-tip">
          <view class="signal-mark"></view>
          <text>{{record.signalTip}}</text>
        </view>
      </view>
    </block>
  </scroll-view>
</view>
