page {
  height: 100%;
  background: #f3f4f2;
}

button {
  margin: 0;
  padding: 0;
  line-height: inherit;
  background: none;
}

button::after {
  display: none;
}

.summary-page {
  display: flex;
  height: 100vh;
  flex-direction: column;
  color: #1d282b;
  background:
    radial-gradient(circle at 8% 8%, rgba(60, 125, 101, .08), transparent 27%),
    #f3f4f2;
}

.page-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 0 0 auto;
  padding-left: 24rpx;
  padding-right: 24rpx;
  box-sizing: content-box;
}

.nav-back,
.nav-spacer {
  width: 88rpx;
  height: 88rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back image {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
}

.summary-scroll {
  flex: 1;
  min-height: 0;
}

.record-heading {
  padding: 42rpx 40rpx 32rpx;
}

.record-date {
  display: block;
  font-size: 42rpx;
  line-height: 56rpx;
  font-weight: 700;
}

.record-duration {
  display: block;
  margin-top: 8rpx;
  color: #657277;
  font-size: 28rpx;
  line-height: 40rpx;
}

.summary-card,
.transcript-card,
.state-card {
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  background: #fff;
  border: 1rpx solid #dde2e0;
  border-radius: 32rpx;
  box-shadow: 0 12rpx 36rpx rgba(30, 48, 52, .05);
}

.summary-card {
  border-left: 8rpx solid #3c7d65;
}

.summary-card.state-pending {
  border-left-color: #9a6a18;
}

.summary-card.state-failed {
  border-left-color: #c83f3f;
}

.summary-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.card-title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
}

.status-label {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  color: #3c7d65;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 600;
  background: #e8f2ee;
  border-radius: 999rpx;
}

.state-pending .status-label {
  color: #80570f;
  background: #f8edd6;
}

.state-failed .status-label {
  color: #a63838;
  background: #f8e2e2;
}

.summary-copy {
  display: block;
  margin-top: 22rpx;
  font-size: 30rpx;
  line-height: 50rpx;
}

.refresh-action {
  min-width: 184rpx;
  min-height: 88rpx;
  margin-top: 20rpx;
  color: #315e6b;
  font-size: 28rpx;
  line-height: 88rpx;
  font-weight: 700;
}

.transcript-card {
  margin-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.transcript-list {
  margin-top: 22rpx;
}

.transcript-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #e7ebe9;
}

.speaker {
  width: 70rpx;
  flex: 0 0 auto;
  color: #315e6b;
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 700;
}

.role-user .speaker {
  color: #80570f;
}

.transcript-copy {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  line-height: 48rpx;
}

.empty-transcript {
  margin-top: 22rpx;
  padding: 30rpx;
  color: #657277;
  font-size: 28rpx;
  line-height: 44rpx;
  text-align: center;
  background: #f5f7f6;
  border-radius: 24rpx;
}

.state-card {
  display: flex;
  margin-top: 72rpx;
  padding: 64rpx 36rpx 42rpx;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.state-title {
  font-size: 36rpx;
  line-height: 50rpx;
  font-weight: 700;
}

.state-desc {
  margin-top: 14rpx;
  color: #657277;
  font-size: 28rpx;
  line-height: 44rpx;
}

.state-action {
  min-width: 260rpx;
  height: 96rpx;
  margin-top: 34rpx;
  color: #fff;
  font-size: 30rpx;
  line-height: 96rpx;
  font-weight: 700;
  background: #315e6b;
  border-radius: 28rpx;
}
