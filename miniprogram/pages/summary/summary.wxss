.container {
  min-height: 100vh;
  background-color: #F8F9FA;
  display: flex;
  flex-direction: column;
}

/* 顶部自定义导航栏 */
.custom-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 100rpx 40rpx 20rpx;
  background-color: #F8F9FA;
}

.nav-back, .nav-placeholder {
  width: 60rpx;
}

.back-icon {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.scroll-content {
  flex: 1;
  padding: 20rpx 0 200rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  margin-top: 100rpx;
  color: #999;
}

/* 卡片 */
.card {
  background: white;
  border-radius: 24rpx;
  margin: 0 40rpx 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.no-margin {
  margin-bottom: 0;
}

/* 元数据卡片 */
.meta-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.meta-time-info {
  display: flex;
  flex-direction: column;
}

.meta-date {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.meta-duration {
  font-size: 26rpx;
  color: #999;
}

.meta-mood {
  font-size: 48rpx;
}

.mood-rating {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.rating-label {
  font-size: 28rpx;
  color: #666;
}

.stars {
  display: flex;
  gap: 8rpx;
}

.star {
  font-size: 32rpx;
  color: #E0E0E0;
}

.star.active {
  color: #FFB300;
}

/* 概要卡片 */
.summary-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
  margin-bottom: 24rpx;
}

.summary-status {
  display: inline-block;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.status-pending {
  color: #9A6700;
  background-color: #FFF8DB;
}

.status-failed {
  color: #B42318;
  background-color: #FFECEB;
}

.topics {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic-tag {
  background-color: #FFF5F2;
  color: #FF6B4A;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
}

/* 重要提及 */
.highlight-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.highlight-item {
  display: flex;
  gap: 16rpx;
}

.highlight-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #FF6B4A;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.highlight-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 兴趣信号卡片 */
.signal-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.signal-icon {
  font-size: 36rpx;
}

.signal-tags {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.signal-tag {
  background-color: #E8F8F5;
  color: #2E7D32;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
}

.signal-tip {
  background-color: #F2FBF7;
  color: #2E7D32;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 底部操作栏 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 40rpx 48rpx;
  background: white;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
}

.reply-btn {
  background-color: #FF6B4A;
  color: white;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
}
