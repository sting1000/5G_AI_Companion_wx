.summary-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF7EE 0%, #F4F7F4 48%, #F8F2EA 100%);
  display: flex;
  flex-direction: column;
  color: var(--color-text-primary);
}

.summary-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 92rpx 34rpx 18rpx;
  box-sizing: border-box;
}

.nav-back,
.nav-placeholder {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back {
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(45, 42, 38, 0.08);
}

.back-icon {
  margin-top: -4rpx;
  font-size: 58rpx;
  line-height: 1;
  color: #2D2A26;
}

.nav-title {
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #2D2A26;
}

.scroll-content {
  flex: 1;
  padding: 18rpx 0 48rpx;
  box-sizing: border-box;
}

.empty-state {
  margin: 90rpx 40rpx 0;
  padding: 64rpx 28rpx;
  border-radius: 30rpx;
  color: var(--color-text-muted);
  font-size: 28rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.78);
}

.summary-hero {
  margin: 0 30rpx 26rpx;
  padding: 34rpx;
  border-radius: 34rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #754833 0%, #B76542 58%, #FF9A6C 145%);
  box-shadow: 0 24rpx 70rpx rgba(128, 70, 40, 0.22);
  box-sizing: border-box;
}

.hero-topline,
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-kicker {
  font-size: 22rpx;
  line-height: 1.2;
  letter-spacing: 3rpx;
  color: rgba(255, 255, 255, 0.62);
}

.summary-state {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.2;
}

.summary-state-done {
  color: #173D2A;
  background: rgba(208, 246, 220, 0.92);
}

.summary-state-pending {
  color: #62420A;
  background: rgba(255, 229, 143, 0.92);
}

.summary-state-failed {
  color: #7F1D1D;
  background: rgba(255, 215, 211, 0.92);
}

.hero-title {
  display: block;
  margin-top: 34rpx;
  font-size: 46rpx;
  line-height: 1.22;
  font-weight: 800;
  color: #FFFFFF;
}

.hero-date {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hero-metrics {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
  padding: 24rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.13);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}

.metric-block {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.metric-value {
  max-width: 100%;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #FFFFFF;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.metric-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.62);
}

.metric-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.18);
}

.mood-card,
.insight-card {
  margin: 0 30rpx 24rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(45, 42, 38, 0.06);
  box-shadow: 0 14rpx 46rpx rgba(75, 68, 58, 0.08);
  box-sizing: border-box;
}

.mood-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.mood-orb {
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.45);
}

.mood-orb text {
  font-size: 28rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.mood-happy { background: linear-gradient(135deg, #FFB75A, #F06E4A); }
.mood-calm { background: linear-gradient(135deg, #FFB36A, #FF765B); }
.mood-low { background: linear-gradient(135deg, #7E92A8, #4B5F73); }
.mood-anxious { background: linear-gradient(135deg, #E07B59, #A73F34); }
.mood-pending { background: linear-gradient(135deg, #C9B16A, #7B6730); }

.mood-copy {
  flex: 1;
  min-width: 0;
}

.section-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #2D2A26;
}

.section-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #66615C;
}

.section-tag {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: #8A4F35;
  background: #FFF0E8;
}

.mood-track {
  height: 12rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #ECE4DB;
}

.mood-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #D1A266, #FF8A65);
}

.summary-status {
  display: inline-flex;
  margin-top: 24rpx;
  margin-bottom: 18rpx;
  font-size: 24rpx;
  line-height: 1.4;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
}

.status-pending {
  color: var(--color-warning-text);
  background-color: var(--color-warning-soft);
}

.status-failed {
  color: var(--color-danger-text);
  background-color: var(--color-danger-soft);
}

.summary-text {
  display: block;
  margin-top: 22rpx;
  font-size: 30rpx;
  color: #2D2A26;
  line-height: 1.72;
}

.summary-placeholder {
  color: #8A8580;
}

.highlight-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.highlight-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #F9F4EE;
}

.highlight-index {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 800;
  color: #FFFFFF;
  background: #FF7A59;
}

.highlight-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #3A332E;
  line-height: 1.55;
}

.signal-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.signal-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: #8A4F35;
  background: #FFF0E8;
}

.signal-tip {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  color: #7C4E36;
  background: #FFF6ED;
  font-size: 25rpx;
  line-height: 1.55;
}

.signal-mark {
  width: 14rpx;
  height: 14rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #D98258;
  box-shadow: 0 0 0 8rpx rgba(217, 130, 88, 0.14);
}
