.container {
  min-height: 100vh;
  background-color: var(--color-bg-page);
  display: flex;
  flex-direction: column;
}

/* 顶部自定义导航栏 */
.custom-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 100rpx 40rpx 20rpx;
  background-color: var(--color-bg-page);
}

.nav-back, .nav-placeholder {
  width: 60rpx;
}

.back-icon {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--color-text-primary);
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.scroll-content {
  flex: 1;
  padding: 20rpx 0 40rpx;
}

/* 空状态 */
.empty-state {
  margin-top: 100rpx;
  color: var(--color-text-muted);
  font-size: 28rpx;
  text-align: center;
}

/* 卡片 */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  margin: 0 40rpx 32rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
}

.no-margin {
  margin-bottom: 0;
}

/* 元数据卡片 */
.meta-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.meta-time-info {
  display: flex;
  flex-direction: column;
}

.meta-date {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.meta-duration {
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.meta-mood {
  font-size: 48rpx;
}

.mood-rating {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.rating-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.stars {
  display: flex;
  gap: 8rpx;
}

.star {
  font-size: 32rpx;
  color: #E0E0E0;
}

.star.active {
  color: #FFB300;
}

/* 概要卡片 */
.summary-text {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
  display: block;
  margin-bottom: 24rpx;
}

.summary-status {
  display: inline-block;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.status-pending {
  color: var(--color-warning-text);
  background-color: var(--color-warning-soft);
}

.status-failed {
  color: var(--color-danger-text);
  background-color: var(--color-danger-soft);
}

.summary-source {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.topics {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic-tag {
  background-color: #FFF5F2;
  color: var(--color-brand);
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
}

/* 重要提及 */
.highlight-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.highlight-item {
  display: flex;
  gap: 16rpx;
}

.highlight-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--color-brand);
  margin-top: 14rpx;
  flex-shrink: 0;
}

.highlight-text {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.5;
}

/* 兴趣信号卡片 */
.signal-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.signal-icon {
  font-size: 36rpx;
}

.signal-tags {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.signal-tag {
  background-color: #E8F8F5;
  color: #2E7D32;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
}

.signal-tip {
  background-color: #F2FBF7;
  color: #2E7D32;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

